# Variable names for local development. Fill these in, or import them into a
# 1Password Environment and mount that Environment at .env.
# dotenv-rails loads .env in development and test. Existing environment
# variables win. Production (Railway) reads these same names from the host.
# Commented lines are optional and stay unset until you uncomment them.

MAIN_DOMAIN=
SMTP_DOMAIN=
SECRET_KEY_BASE=
DEVISE_SECRET_KEY=

# Active Record Encryption. Optional outside production: development and test
# fall back to fixed, insecure keys. Generate real ones with
# `bin/rails db:encryption:init`.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# ACTIVE_RECORD_ENCRYPTION_WRITE=true
# ACTIVE_RECORD_ENCRYPTION_ALLOW_PLAINTEXT=false

# Postal address for the footer of newsletters (required to send one).
# MAILING_ADDRESS=

MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
# Optional: a separate, fully private bucket for export ZIPs, and its region
# if that differs from AWS_BUCKET's. Without it they go under exports/ in
# AWS_BUCKET.
# AWS_EXPORTS_BUCKET=
# AWS_EXPORTS_REGION=

STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SIGNING_SECRET=
STRIPE_MONTHLY_PLAN=
STRIPE_YEARLY_PLAN=

# AI reflections (Entry::AiAssistant). Both must be set, or the reflect button is hidden.
ANTHROPIC_API_KEY=
REFLECTION_MODEL=claude-opus-5-5

# Cloudflare Access in front of admin pages (CloudflareAccess). Leave unset to
# turn the check off, as in development and test.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=dabble.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GOOGLE_ANALYTICS_4_ID=
SENTRY_DSN=

MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
SPOTIFY_API_CLIENT=
SPOTIFY_API_SECRET=
REFERRERS=
RACK_TIMEOUT_SERVICE_TIMEOUT=

# REDIS_URL=
# DATABASE_URL=
# PAYMENT_LINK=
# SIDEKIQ_CRON_ENABLED=

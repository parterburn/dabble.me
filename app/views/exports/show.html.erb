<% title 'Your export — Dabble me.' %>
<% content_for :tailwind, true %>

<div class="tw mx-auto max-w-2xl pt-4 pb-16 sm:pt-8">
  <header class="mb-8">
    <h1 class="font-serif text-4xl tracking-tight text-primary sm:text-5xl">Your export</h1>
    <p class="mt-2 text-muted">Requested <%= @export.created_at.strftime("%B %-d, %Y") %></p>
  </header>

  <section class="card p-6 sm:p-8">
    <% if @export.downloadable? %>
      <p class="text-primary">
        <%= pluralize(number_with_delimiter(@export.entry_count), "entry") %><% if @export.image_count.positive? %> and <%= pluralize(number_with_delimiter(@export.image_count), "photo") %><% end %>,
        as a ZIP file (<%= number_to_human_size(@export.byte_size) %>).
      </p>
      <p class="mt-3 text-sm text-muted">
        Inside: <code>journal.html</code> to read in any browser, <code>journal.md</code> in Markdown<% if @export.image_count.positive? %>, and an <code>images</code> folder<% end %>.
        Available until <%= @export.expires_at.strftime("%B %-d, %Y") %>, then deleted.
      </p>
      <% if @export.skipped_image_count.positive? %>
        <p class="mt-3 text-sm text-muted">
          <%= pluralize(@export.skipped_image_count, "photo") %> couldn't be read and <%= @export.skipped_image_count == 1 ? "was" : "were" %> left out.
        </p>
      <% end %>
      <%= link_to "Download", download_export_path(@export), class: "button-primary mt-5 inline-block w-full text-center sm:w-auto" %>
    <% elsif @export.preparing? %>
      <p class="text-primary">This export is still being prepared. We'll email you when it's ready.</p>
    <% elsif @export.failed? %>
      <p class="text-primary">Something went wrong preparing this export.</p>
      <%= link_to "Request a new export", edit_user_registration_path(anchor: "export"), class: "button-secondary mt-5 inline-block" %>
    <% else %>
      <p class="text-primary">This export has expired and its file was deleted.</p>
      <%= link_to "Request a new export", edit_user_registration_path(anchor: "export"), class: "button-secondary mt-5 inline-block" %>
    <% end %>
  </section>
</div>

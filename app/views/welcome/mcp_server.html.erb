<% content_for :title, "Dabble Me AI Connector: Use Your Journal with ChatGPT and Claude" %>
<% content_for :social_title, "Dabble Me AI Connector — Your private journal in ChatGPT and Claude" %>
<% content_for :description, "Connect your private Dabble Me journal to ChatGPT or Claude. Ask about past entries, look back on a month or a year, and save new reflections. You stay in control." %>
<% content_for :keywords, "journal app for ChatGPT,Claude journal integration,AI journal,journal app for AI reflection,Dabble Me AI Connector" %>

<%
claude_plugin_url = ApplicationHelper.claude_plugin_directory_url
chatgpt_plugin_url = ApplicationHelper.chatgpt_plugin_directory_url
connector_address = ApplicationHelper.mcp_server_url
faq_items = [
  {
    question: "What can the AI Connector do?",
    answer: "It lets ChatGPT, Claude, or another AI app you connect search and read your journal, spot patterns over time, and save new entries for you. It only works on your journal, and only after you approve it."
  },
  {
    question: "Does it work with ChatGPT?",
    answer: "Yes. Add Dabble Me from the ChatGPT plugin directory, then sign in to Dabble Me when ChatGPT asks."
  },
  {
    question: "Does it work with Claude?",
    answer: "Yes. Add Dabble Me from the Claude plugin directory, then sign in to Dabble Me when Claude asks."
  },
  {
    question: "Can the AI app see anyone else's journal?",
    answer: "No. A connection only ever reaches the journal of the person who approved it."
  },
  {
    question: "How do I disconnect an AI app?",
    answer: "Go to Account security → Connected apps on Dabble Me and remove it. It loses access right away."
  }
]
structured_data = [
  article_json_ld(
    headline: "Dabble Me AI Connector: Use Your Journal with ChatGPT and Claude",
    path: mcp_server_docs_path,
    published: "2026-07-23",
    modified: "2026-11-07",
    about: ["AI journaling", "ChatGPT journal integration", "Claude journal integration"]
  ),
  {
    "@type": "FAQPage",
    mainEntity: faq_items.map do |item|
      { "@type": "Question", name: item[:question], acceptedAnswer: { "@type": "Answer", text: item[:answer] } }
    end
  }
]
%>

<% content_for :head do %>
  <%= json_ld_script_tag structured_data %>
  <script>
    // Technical sections moved to the developer page; keep old deep links working.
    if (/^#(tool-|tools$|agent-instructions$|agent-prompt$)/.test(location.hash)) {
      location.replace("<%= mcp_server_developer_docs_path %>" + location.hash);
    }
  </script>
<% end %>

<section class="py-12 lg:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <header class="text-center">
      <span class="badge badge-accent text-sm font-semibold dark:text-olive-800">DABBLE ME PRO</span>
      <h1 class="mt-5 font-serif text-4xl sm:text-5xl tracking-tight">
        Dabble Me AI Connector
      </h1>
      <p class="mt-4 text-xl text-primary max-w-3xl mx-auto">
        Use your private journal with ChatGPT and Claude.
      </p>
      <p class="mt-4 text-base leading-relaxed text-muted max-w-2xl mx-auto">
        Ask about past entries, look back on a month or a year, or save a new reflection, just by chatting.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="<%= claude_plugin_url %>" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Add to Claude</a>
        <a href="<%= chatgpt_plugin_url %>" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Add to ChatGPT</a>
        <a href="#setup-other" class="btn btn-secondary">Other AI apps</a>
      </div>
      <% unless user_signed_in? %>
        <p class="mt-4 text-sm text-muted">
          New to Dabble Me? <a href="<%= new_user_registration_path %>" class="text-accent hover:text-primary underline">Start journaling</a>
        </p>
      <% end %>
    </header>

    <section class="mt-16" id="examples">
      <h2 class="font-serif text-3xl text-primary">What you can ask</h2>
      <p class="mt-3 text-muted">Talk to your AI app like you would to a friend who has read your journal.</p>
      <div class="mt-6 grid sm:grid-cols-2 gap-5">
        <% [
          ["Reflect on a month", "Summarize my journal entries from last month. What themes kept coming up?"],
          ["Find a recurring topic", "Find every time I mentioned burnout and show how I wrote about it over time."],
          ["Review a year", "How often did I journal this year? What did I write about most?"],
          ["Recall a memory", "What did I write about my trip to Iceland? Include dates and short excerpts."],
          ["Look for progress", "Search my journal for running and summarize the milestones I recorded."],
          ["Save a reflection", "Add this to today's journal: I felt calmer after taking a long walk."]
        ].each do |title, prompt| %>
          <div class="card p-5">
            <h3 class="font-sans font-semibold text-base tracking-tight text-primary"><%= title %></h3>
            <blockquote class="mt-2 text-sm leading-relaxed text-muted">“<%= prompt %>”</blockquote>
          </div>
        <% end %>
      </div>
    </section>

    <section class="mt-16" id="setup">
      <h2 class="font-serif text-3xl text-primary">How to connect</h2>

      <div class="mt-6 card p-6" id="before-connecting">
        <h3 class="font-serif text-2xl text-primary">Before you start</h3>
        <ol class="mt-4 list-decimal pl-5 space-y-2 text-muted">
          <li>You need a Dabble Me PRO subscription.</li>
          <li>We’ll email you whenever a new app connects. You can review and remove connected apps anytime in <a href="<%= security_path(anchor: "connected-apps") %>" class="text-accent hover:text-primary underline">Account security</a>.</li>
        </ol>
      </div>

      <div class="mt-8 card p-6" id="setup-claude">
        <h3 class="font-serif text-2xl text-primary">Claude</h3>
        <ol class="mt-4 list-decimal pl-5 space-y-2 text-muted">
          <li>Open <a href="<%= claude_plugin_url %>" class="text-accent hover:text-primary underline" target="_blank" rel="noopener noreferrer">Dabble Me in the Claude plugin directory</a> and add it.</li>
          <li>When Claude asks you to connect, sign in to Dabble Me and approve access.</li>
          <li>Turn on Dabble Me in a chat, then try one of the questions above.</li>
        </ol>
      </div>

      <div class="mt-8 card p-6" id="setup-chatgpt">
        <h3 class="font-serif text-2xl text-primary">ChatGPT</h3>
        <ol class="mt-4 list-decimal pl-5 space-y-2 text-muted">
          <li>Open <a href="<%= chatgpt_plugin_url %>" class="text-accent hover:text-primary underline" target="_blank" rel="noopener noreferrer">Dabble Me in the ChatGPT plugin directory</a> and add it.</li>
          <li>When ChatGPT asks you to connect, sign in to Dabble Me and approve access.</li>
          <li>Turn on Dabble Me in a chat, then try one of the questions above.</li>
        </ol>
      </div>

      <div class="mt-8 card p-6" id="setup-other">
        <h3 class="font-serif text-2xl text-primary">Other AI apps</h3>
        <p class="mt-3 text-muted">
          If your AI app lets you add a custom connector, add one with this address, then sign in to Dabble Me when it asks:
        </p>
        <p class="mt-4"><code class="block text-base select-all break-all bg-olive-200 px-4 py-3 rounded text-olive-900"><%= connector_address %></code></p>
        <p class="mt-4 text-sm text-muted">
          Setting this up in a developer tool or an AI agent? See the <a href="<%= mcp_server_developer_docs_path %>" class="text-accent hover:text-primary underline">technical details</a>.
        </p>
      </div>
    </section>

    <section class="mt-16" id="privacy">
      <h2 class="font-serif text-3xl text-primary">Private, and in your control</h2>
      <div class="mt-6 grid sm:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="font-serif text-xl text-primary">You sign in on Dabble Me</h3>
          <p class="mt-3 text-sm text-muted">
            You approve access on Dabble Me’s own site. You never type your password into the chat.
          </p>
        </div>
        <div class="card p-6">
          <h3 class="font-serif text-xl text-primary">Disconnect any time</h3>
          <p class="mt-3 text-sm text-muted">
            See and remove connected apps under
            <a href="<%= security_path(anchor: "connected-apps") %>" class="text-accent hover:text-primary underline">Account security → Connected apps</a>.
          </p>
        </div>
      </div>
      <div class="mt-6 card p-6 bg-accent/5 border-accent/20">
        <p class="text-primary font-medium">Dabble Me does not train an AI model on your journal.</p>
        <p class="mt-2 text-sm text-muted">
          When you ask a connected AI app about your entries, the entries it reads are sent to that app’s company under
          its own terms and privacy policy. Connect only apps you trust.
        </p>
      </div>
    </section>

    <section class="mt-16" id="faq">
      <h2 class="font-serif text-3xl text-primary">Questions</h2>
      <div class="mt-6 space-y-5">
        <% faq_items.each do |item| %>
          <article class="card p-6">
            <h3 class="font-serif text-xl text-primary"><%= item[:question] %></h3>
            <p class="mt-2 text-sm leading-relaxed text-muted"><%= item[:answer] %></p>
          </article>
        <% end %>
      </div>
    </section>

    <section class="mt-16 card p-8 text-center">
      <h2 class="font-serif text-3xl text-primary">Choose the journal that fits</h2>
      <p class="mt-3 text-muted">
        See how Dabble Me compares with other journals that work with ChatGPT and Claude.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row justify-center gap-3">
        <a class="btn btn-secondary" href="<%= day_one_ai_journaling_path %>">Dabble Me vs. Day One</a>
        <a class="btn btn-secondary" href="<%= best_journaling_apps_with_mcp_path %>">Best journaling apps for ChatGPT &amp; Claude</a>
      </div>
    </section>
  </div>
</section>

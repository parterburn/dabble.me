<% content_for :title, "Dabble Me MCP Server: Technical Reference" %>
<% content_for :social_title, "Dabble Me MCP Server — Technical reference" %>
<% content_for :description, "Technical reference for the Dabble Me remote MCP server: endpoint, OAuth 2.0 with PKCE, setup steps for AI agents, and the live tool reference." %>
<% content_for :keywords, "AI journal with MCP,personal journal MCP server,Dabble Me MCP,remote MCP server,journal app for ChatGPT,Claude journal integration" %>

<%
mcp_endpoint = ApplicationHelper.mcp_server_url
claude_plugin_url = ApplicationHelper.claude_plugin_directory_url
chatgpt_plugin_url = ApplicationHelper.chatgpt_plugin_directory_url
setup_guide_url = "#{ApplicationHelper.site_public_base_url}#{mcp_server_developer_docs_path}#agent-instructions"
agent_setup_prompt = "Set up Dabble Me for this agent using the official guide at #{setup_guide_url}. " \
  "Prefer the official Dabble Me plugin from this app’s plugin directory when one exists; " \
  "otherwise add the remote MCP server at #{mcp_endpoint}. " \
  "Then start the Dabble Me OAuth flow so I can sign in."
faq_items = [
  {
    question: "How should an AI assistant attach a photo to a journal entry?",
    answer: "Prefer create_entry with image_url when a public https image URL is already available—Dabble Me fetches and attaches it server-side. That path avoids client sandbox egress allowlists and large base64 payloads. Only for local bytes without a public URL, call get_image_upload_url, upload with the returned PUT URL, then pass uploaded_image_key to create_entry. Use image_base64 only as a small last resort."
  },
  {
    question: "Claude can’t upload a photo to Dabble Me—what should I check?",
    answer: "If Claude is using get_image_upload_url, its code-execution sandbox must allow HTTPS egress to the Amazon S3 host in the returned upload URL (often a bucket like dabble-me.s3.amazonaws.com). In Claude settings → Capabilities, enable Code execution and file creation, then either allow that specific domain or choose All domains. On Team/Enterprise plans, org owners may control this under Organization settings → Capabilities. If domain allowlist entries under “Package managers only” do not stick, switching to All domains is a known workaround. Prefer create_entry image_url whenever Claude already has a public https image URL—that sidesteps the S3 allowlist entirely."
  },
  {
    question: "Can the connector read another user's journal?",
    answer: "No. OAuth binds every tool call to the signed-in Dabble Me account. Tool arguments cannot select another user."
  }
]
structured_data = [
  article_json_ld(
    type: "TechArticle",
    headline: "Dabble Me MCP Server: Technical Reference",
    path: mcp_server_developer_docs_path,
    published: "2026-07-23",
    modified: "2026-11-07",
    about: ["Model Context Protocol", "AI journaling", "OAuth 2.0"]
  ),
  {
    "@type": "FAQPage",
    mainEntity: faq_items.map do |item|
      { "@type": "Question", name: item[:question], acceptedAnswer: { "@type": "Answer", text: item[:answer] } }
    end
  }
]
%>

<% content_for :head do %>
  <%= json_ld_script_tag structured_data %>
<% end %>

<section class="py-12 lg:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <header class="text-center">
      <span class="badge badge-accent text-sm font-semibold dark:text-olive-800">FOR DEVELOPERS AND AI AGENTS</span>
      <h1 class="mt-5 font-serif text-4xl sm:text-5xl tracking-tight">
        Dabble Me MCP Server
      </h1>
      <p class="mt-4 text-xl text-primary max-w-3xl mx-auto">
        Technical reference for connecting MCP clients and AI agents to Dabble Me.
      </p>
      <p class="mt-4 text-base leading-relaxed text-muted max-w-3xl mx-auto">
        Dabble Me is an <strong class="text-primary">AI journal with MCP</strong>: a remote Model Context Protocol server
        for people looking for a <strong class="text-primary">journal app for ChatGPT</strong>, a
        <strong class="text-primary">Claude journal integration</strong>, a
        <strong class="text-primary">personal journal MCP server</strong>, or a
        <strong class="text-primary">journal app for AI reflection</strong>.
        Setting up Claude or ChatGPT yourself? The <a href="<%= mcp_server_docs_path %>" class="text-accent hover:text-primary underline">AI Connector guide</a> is simpler.
      </p>
    </header>

    <section class="mt-12 card p-6" id="endpoint">
      <h2 class="font-serif text-2xl text-primary">Server URL</h2>
      <p class="mt-3 text-muted">Remote Streamable HTTP server. OAuth 2.0 with PKCE; no API key or client secret.</p>
      <p class="mt-4"><code class="block text-base select-all break-all bg-olive-200 px-4 py-3 rounded text-olive-900"><%= mcp_endpoint %></code></p>
      <p class="mt-4 text-sm text-muted">Tool calls require a Dabble Me PRO account with a passkey or two-factor authentication.</p>
    </section>

    <section class="mt-8 card p-6" id="agent-prompt">
      <h2 class="font-serif text-2xl text-primary">Quick setup via agent prompt</h2>
      <p class="mt-3 text-muted">
        Click to copy this prompt, then paste it into an AI agent. It reads this guide and either connects Dabble Me
        itself or tells you which connector to add.
      </p>
      <button
        type="button"
        class="mt-4 w-full text-left cursor-pointer rounded border-2 border-olive-300 bg-olive-200 px-4 py-3 text-olive-900 hover:border-olive-500 transition-colors"
        data-copy-prompt="<%= agent_setup_prompt %>"
        aria-describedby="agent-prompt-status"
      >
        <span class="block text-base leading-relaxed"><%= agent_setup_prompt %></span>
        <span class="mt-2 block text-sm font-semibold text-olive-600" id="agent-prompt-status" aria-live="polite" data-copy-prompt-status>Click to copy</span>
      </button>
    </section>

    <section class="mt-8 card p-6" id="agent-instructions">
      <h2 class="font-serif text-2xl text-primary">Instructions for AI agents</h2>
      <p class="mt-3 text-muted">If you are an AI agent setting up Dabble Me for a user, follow these steps.</p>
      <ol class="mt-4 list-decimal pl-5 space-y-2 text-muted">
        <li>If you can change your own MCP configuration, add a remote HTTP MCP server named <code>dabble-me</code> with the URL <code><%= mcp_endpoint %></code>. Do not add an API key, client secret, or custom headers.</li>
        <li>Then start your client’s OAuth sign-in so the user can sign in to Dabble Me and approve access. Never ask the user to paste a password, two-factor code, passkey, or token into the chat.</li>
        <li>If you cannot add MCP servers yourself (Claude on claude.ai or the Claude apps, or ChatGPT), do not look for a workaround. In Claude, send the user to the <a href="<%= claude_plugin_url %>" class="text-accent hover:text-primary underline" target="_blank" rel="noopener noreferrer">Dabble Me Claude plugin</a>. In ChatGPT, send them to the <a href="<%= chatgpt_plugin_url %>" class="text-accent hover:text-primary underline" target="_blank" rel="noopener noreferrer">Dabble Me ChatGPT plugin</a>. Step-by-step instructions for people are in the <a href="<%= mcp_server_docs_path %>#setup" class="text-accent hover:text-primary underline">AI Connector guide</a>.</li>
        <li>After sign-in, confirm the connection with a read-only tool such as <code>list_entries</code> or <code>analyze_entries</code> for a recent date range. Do not create a test entry. Some clients only load new tools after a reload or in a new chat.</li>
        <li>Only Dabble Me PRO accounts with a passkey or two-factor authentication can use the tools. The connection acts as the user who approved it and only reads and writes that user’s journal.</li>
      </ol>
    </section>

    <section class="mt-8 card p-6" id="setup-other">
      <h2 class="font-serif text-2xl text-primary">Connect another MCP client</h2>
      <p class="mt-3 text-muted">
        Add <code><%= mcp_endpoint %></code> as a remote <strong class="text-primary">Streamable HTTP</strong> server.
        Let the client discover the OAuth metadata, register as a public client, open the authorization page, and
        exchange the authorization code using PKCE. No API key or client secret is required.
      </p>
    </section>

    <section class="mt-16" id="authentication">
      <h2 class="font-serif text-3xl text-primary">Authentication</h2>
      <div class="mt-6 grid sm:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="font-serif text-xl text-primary">OAuth 2.0 + PKCE</h3>
          <p class="mt-3 text-sm text-muted">
            Users sign in on Dabble Me’s own domain and approve the <code>mcp:access</code> scope. Dabble Me never asks
            for a password inside the AI client.
          </p>
        </div>
        <div class="card p-6">
          <h3 class="font-serif text-xl text-primary">Strong account security</h3>
          <p class="mt-3 text-sm text-muted">
            Tool calls require Dabble Me PRO plus a passkey or two-factor authentication. Users review and disconnect clients under
            <a href="<%= security_path(anchor: "connected-apps") %>" class="text-accent hover:text-primary underline">Account security → Connected apps</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-16" id="tools">
      <h2 class="font-serif text-3xl text-primary">Available MCP tools</h2>
      <p class="mt-3 text-muted">
        These names and descriptions come from the same metadata exposed to MCP clients.
      </p>
      <div class="mt-6 space-y-5">
        <% @mcp_tools.each do |tool| %>
          <article class="card p-6" id="tool-<%= tool[:name].tr("_", "-") %>">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
              <h3 class="font-serif text-2xl text-primary"><%= tool[:title] %></h3>
              <code class="text-sm bg-olive-200 text-olive-900 px-2 py-1 rounded"><%= tool[:name] %></code>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted"><%= tool[:description] %></p>
            <% if tool[:properties].present? %>
              <h4 class="mt-5 font-semibold text-sm text-primary">Arguments</h4>
              <dl class="mt-2 space-y-2 text-sm">
                <% tool[:properties].each do |name, details| %>
                  <div>
                    <dt class="inline font-mono text-primary"><%= name %><%= " (required)" if tool[:required].include?(name.to_s) %></dt>
                    <dd class="inline text-muted"> — <%= details[:description].presence || details["description"].presence || details[:type] || details["type"] %></dd>
                  </div>
                <% end %>
              </dl>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>

    <section class="mt-16" id="faq">
      <h2 class="font-serif text-3xl text-primary">Technical questions</h2>
      <div class="mt-6 space-y-5">
        <% faq_items.each do |item| %>
          <article class="card p-6">
            <h3 class="font-serif text-xl text-primary"><%= item[:question] %></h3>
            <p class="mt-2 text-sm leading-relaxed text-muted"><%= item[:answer] %></p>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</section>

<% content_for :scripts do %>
  <script>
    document.querySelectorAll('[data-copy-prompt]').forEach(function(button) {
      var status = button.querySelector('[data-copy-prompt-status]');
      var originalStatus = status.textContent;

      function showCopied() {
        status.textContent = 'Copied! Paste it into your AI agent.';
        setTimeout(function() { status.textContent = originalStatus; }, 2500);
      }

      function copyWithSelection(text) {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.className = 'sr-only';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
        showCopied();
      }

      button.addEventListener('click', function() {
        var text = button.dataset.copyPrompt;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showCopied).catch(function() { copyWithSelection(text); });
        } else {
          copyWithSelection(text);
        }
      });
    });
  </script>
<% end %>

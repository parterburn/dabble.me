<% content_for :title, "Pricing" %>
<% content_for :full_title, "Pricing — Dabble Me Private Journal" %>
<% content_for :description, "Start journaling free forever, or upgrade to Dabble Me PRO ($4/mo or $40/yr) for photos, editing, search, On This Day, Year in Review, custom schedules, and imports." %>
<% content_for :head do %>
  <%= json_ld_script_tag organization_json_ld, web_application_json_ld %>
<% end %>
<%
check_icon = '<svg class="h-5 w-5 text-accent shrink-0 mt-0.5 inline-block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-label="Included"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>'.html_safe
none = '<span class="text-subtle" aria-label="Not included">—</span>'.html_safe
plan_rows = [
  ["Read, write & delete entries", check_icon, check_icon],
  ["Ways to write", "iOS app, widgets, email reply", "iOS app, widgets, email reply, web editor, Claude/ChatGPT"],
  ["Reminders & email schedule", "Daily iOS reminder + email every other Sunday", "Daily iOS reminder + custom email schedule"],
  ["Past entries in your prompt emails", check_icon, check_icon],
  ["On-device Apple Intelligence (prompts, reflections, tag suggestions)", check_icon, "Included, plus lines in your Year in Review"],
  ["Photos (up to #{CollageGenerator::MAX_IMAGES}) & web links", none, check_icon],
  ["Edit entries (text, photos, dates)", none, check_icon],
  ["On This Day & Year in Review", none, check_icon],
  ["Search, calendar, stats & #hashtag dates", none, check_icon],
  ["Imports (Day One, OhLife & more) & Spotify", none, check_icon],
  ["Optional Claude & ChatGPT connector", none, check_icon],
  ["Privacy & full export", "Always included", "Always included, with photos"]
]
trust_line = "Cancel anytime · Keep all your entries · 30-day refund on web purchases"
%>
<main>
  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="font-serif text-4xl sm:text-5xl text-primary">Simple pricing for a journal you’ll actually keep.</h1>
        <p class="mt-4 text-muted text-lg max-w-2xl mx-auto">
          Start free forever, or unlock PRO for photos, editing, full search, On This Day, Year in Review, and custom schedules.
        </p>
      </div>

      <% if user_signed_in? %>
        <!-- Stripe checkout. Gumroad and PayPal are closed to new subscribers. -->
        <div class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto">
          <!-- Yearly Plan -->
          <div class="card p-8 border-accent ring-2 ring-accent/20 relative">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="badge badge-accent dark:text-olive-800">Best value</span>
            </div>
            <p class="text-center">
              <span class="font-serif text-5xl text-primary">$40</span>
              <span class="text-muted">/year</span>
            </p>
            <p class="text-center text-sm text-accent font-medium mt-2">About $3.33/month, 2 months free</p>
            <%= button_to checkout_path(plan: "yearly"), method: "post", class: "btn btn-primary w-full mt-6" do %>
              Subscribe Yearly
            <% end %>
          </div>

          <!-- Monthly Plan -->
          <div class="card p-8">
            <p class="text-center">
              <span class="font-serif text-5xl text-primary">$4</span>
              <span class="text-muted">/month</span>
            </p>
            <p class="text-center text-sm text-subtle mt-2">&nbsp;</p>
            <%= button_to checkout_path(plan: "monthly"), method: "post", class: "btn btn-secondary w-full mt-6" do %>
              Subscribe Monthly
            <% end %>
          </div>
        </div>

        <p class="mt-6 text-center text-sm text-muted"><%= trust_line %></p>
        <div id="error-message" class="mt-6 text-center text-red-600"></div>
      <% else %>
        <% session["user_return_to"] = subscribe_path %>

        <div class="card p-8 max-w-md mx-auto text-center border-accent ring-2 ring-accent/20">
          <p class="font-semibold text-primary">Dabble Me PRO</p>
          <p class="mt-3">
            <span class="font-serif text-5xl text-primary">$40</span>
            <span class="text-muted">/year</span>
          </p>
          <p class="mt-1 text-sm text-muted">About $3.33/month, save 17% · or $4/month</p>

          <div class="mt-6">
            <%= link_to "Sign Up for PRO", new_user_registration_path, class: "btn btn-primary w-full" %>
          </div>
          <p class="mt-4 text-sm">
            <%= link_to "Already have an account? Log in to upgrade →", new_user_session_path, class: "text-accent hover:text-primary underline" %>
          </p>
          <p class="mt-6 text-xs text-subtle"><%= trust_line %></p>
        </div>

        <p class="mt-6 text-center text-sm text-muted">
          Just want to try it first? <%= link_to "Start with the Free plan ($0 forever) →", new_user_registration_path, class: "text-accent hover:text-primary underline" %>
        </p>
      <% end %>

      <%= render "pro_features" %>

      <!-- Plan comparison -->
      <section class="mt-20 max-w-4xl mx-auto">
        <h2 class="text-3xl text-center mb-8">Compare plans</h2>
        <div class="card overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead>
              <tr class="border-b border-subtle">
                <th scope="col" class="p-4 font-semibold text-primary">Feature</th>
                <th scope="col" class="p-4 font-semibold text-primary">Free <span class="font-normal text-muted">($0 forever)</span></th>
                <th scope="col" class="p-4 font-semibold text-primary">PRO <span class="font-normal text-muted">($4/mo or $40/yr)</span></th>
              </tr>
            </thead>
            <tbody>
              <% plan_rows.each do |feature, free, pro| %>
                <tr class="border-b border-subtle last:border-0">
                  <th scope="row" class="p-4 font-medium text-primary align-top"><%= feature %></th>
                  <td class="p-4 text-muted align-top"><%= free %></td>
                  <td class="p-4 text-muted align-top"><%= pro %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Trust, privacy and refunds -->
      <section class="mt-20 max-w-3xl mx-auto text-center">
        <h2 class="text-3xl">Always private. Never locked in.</h2>
        <p class="mt-4 text-muted text-lg">
          Your entries are never shared, indexed, or used to train AI. If you ever cancel PRO, your account moves cleanly to the free plan: all your past entries stay private and readable, and you can export everything anytime.
        </p>
        <p class="mt-4 text-muted">
          If PRO doesn’t feel right, email <%= mail_to "hello@dabble.me", "hello@dabble.me", subject: "Refund Request", class: "text-accent hover:text-primary underline" %> within 30 days of a charge on dabble.me and we’ll take care of a refund. Subscriptions bought in the iPhone app are billed by Apple, so refunds for those go through Apple.
        </p>
      </section>
    </div>
  </section>

  <!-- Paul Graham testimonial -->
  <section class="py-20 lg:py-28 bg-surface border-y border-subtle">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <a href="https://x.com/paulg/status/1746341562286539118" target="_blank" rel="noopener" class="hover:scale-105 transition-transform duration-300 block">
        <blockquote class="font-serif text-2xl sm:text-3xl lg:text-4xl text-primary leading-relaxed">
          “The pro version of Dabble.Me costs $3 a month, and it is worth so much more than that.”
        </blockquote>

        <div class="mt-10 flex flex-col items-center">
          <span class="w-16 h-16 rounded-full bg-olive-100 flex items-center justify-center mb-4">
            <img src="<%= asset_path('pg.jpg') %>" alt="Paul Graham" class="w-full h-full object-cover rounded-full">
          </span>
          <span class="font-medium text-primary">Paul Graham</span>
          <span class="text-sm text-muted">Co-founder, Y Combinator</span>
          <span class="text-sm text-subtle">January 2024, when PRO was $3 a month</span>
        </div>
      </a>
    </div>
  </section>
</main>

<%# locals: url:, method:, submit: %>
<div class="card max-w-2xl p-6 sm:p-8">
  <%= form_for :inspiration, url: url, method: method, html: { class: "space-y-5" } do |f| %>
    <%= render "devise/shared/error_messages", resource: @inspiration %>

    <div>
      <%= f.label :category, class: "field-label" %>
      <%= f.select :category, Inspiration.order(:category).all.pluck(:category).uniq, {}, { class: "field-input" } %>
    </div>

    <div>
      <%= f.label :body, class: "field-label" %>
      <%= f.text_area :body, rows: 3, class: "field-input" %>
    </div>

    <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center">
      <%= f.submit submit, class: "button-primary" %>
      <%= link_to "Cancel", inspirations_path, class: "button-secondary" %>
    </div>
  <% end %>
</div>

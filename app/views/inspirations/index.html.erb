<% title "Inspirations — Dabble me." %>
<% content_for :tailwind, true %>
<% icon_link = "inline-flex size-8 items-center justify-center rounded-lg text-muted hover:bg-surface-elevated" %>

<% content_for :admin_actions do %>
  <%= link_to "Add new inspiration", new_inspiration_path, class: "button-primary" %>
<% end %>

<div class="tw mx-auto max-w-6xl pt-4 pb-16 sm:pt-8">
  <%= render "admin/header", title: "Inspirations" %>

  <div class="card overflow-x-auto">
    <table class="data-table whitespace-nowrap">
      <thead>
        <tr>
          <th><span class="sr-only">Actions</span></th>
          <th>Entries</th>
          <th>Category</th>
          <th>Inspiration</th>
        </tr>
      </thead>
      <tbody>
        <% @inspirations.each do |i| %>
          <%# Highlight the one just saved. %>
          <tr class="<%= 'bg-green-50' if notice && @last_updated&.id == i.id %>">
            <td class="whitespace-nowrap">
              <%= link_to edit_inspiration_path(i), class: "#{icon_link} hover:text-primary", title: "Edit Inspiration", "aria-label": "Edit inspiration" do %>
                <span class="slab-icon slab-icon--edit" aria-hidden="true"></span>
              <% end %>
              <% if i.category == "OhLife" %>
                <span class="<%= icon_link %> cursor-default hover:bg-transparent" title="Required by system">
                  <span class="slab-icon slab-icon--lock" aria-hidden="true"></span>
                  <span class="sr-only">Required by system</span>
                </span>
              <% else %>
                <%= link_to inspiration_path(i), class: "#{icon_link} hover:text-red-700", title: "Delete Inspiration", "aria-label": "Delete inspiration",
                      method: :delete, data: { confirm: 'Are you sure you want to delete this inspiration? There is no undo.' } do %>
                  <span class="slab-icon slab-icon--trash" aria-hidden="true"></span>
                <% end %>
              <% end %>
            </td>
            <td><%= number_with_delimiter(i.entries.count) %></td>
            <td class="whitespace-nowrap"><%= i.category %></td>
            <td class="min-w-64 whitespace-normal"><%= i.body.html_safe %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

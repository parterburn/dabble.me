<% title "Inspirations — Dabble me." %>

<div class="row">
  <div class="col-md-12">
    <p>
      <%= link_to "Add new inspiration", new_inspiration_path, class: "btn btn-info" %>
    </p>
  </div>
</div>

<div class="row">
  <div class="col-md-1">
    <h4>Actions</h4>
  </div>
  <div class="col-md-1">
    <h4>Entries</h4>
  </div>
  <div class="col-md-2">
    <h4>Category</h4>
  </div>
  <div class="col-md-8">
    <h4>Inspiration</h4>
  </div>
</div>

<% @inspirations.each do |i| %>
  <% add_class = "" %>
  <% if notice && @last_updated.id == i.id %>
    <% add_class = "s-highlight" %>
  <% end %>
  <div class="row s-inspiration-admin <%= add_class %>">
    <div class="col-md-1">
      <%= link_to edit_inspiration_path(i), class: "noline", title: "Edit Inspiration" do %>
        <i class="fa fa-pencil"></i>
      <% end %>
      &nbsp;
      <% if i.category == "OhLife" %>
        <i class="fa fa-lock" title="Required by system"></i>
      <% else %>
        <%= link_to inspiration_path(i), title: "Delete Inspiration", class: "s-delete", method: :delete, data: { confirm: 'Are you sure you want to delete this inspiration? There is no undo.' } do %>
          <i class="fa fa-trash"></i>
        <% end %>
      <% end %>
    </div>
    <div class="col-md-1">
      <%= number_with_delimiter(i.entries.count) %>
    </div>
    <div class="col-md-2">
      <%= i.category %>
    </div>
    <div class="col-md-8">
      <%= i.body.html_safe %>
    </div>
  </div>
<% end %>

<% title "#{@title} — Dabble me." %>
<div class="row">
  <%= render "sidebar" %>

  <div class="col-md-8 col-md-offset-1">
    <div class="center">
      <%= paginate @entries %>
    </div>

    <div class="s-photo-grid">
      <% @entries.each do |entry| %>
        <%= link_to day_entry_path(year: entry.date.year, month: entry.date.month, day: entry.date.day), title: photo_tooltip(entry, @user_today), rel: "tooltip", class: "s-photo-grid__photo" do %>
          <%= photo_thumbnail(entry) %>
        <% end %>
      <% end %>
    </div>

    <div class="center">
      <%= paginate @entries %>
    </div>
  </div>
</div>

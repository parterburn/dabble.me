<% can_reflect = current_user.can_ai? && entry.body.present? && Entry::AiAssistant.configured? %>
<%# label: text for the strip above the date, in place of the "on this day" one. %>
<% label = local_assigns[:label] %>
<% cache [entry, current_user.is_pro?, can_reflect, @search.present?, @hashtags.present?, label] do %>
  <%= render "entries/entry_header", entry: entry, label: label, can_reflect: can_reflect %>
  <div class="s-scrollable">
    <%# Tags link to search, which is PRO-only, like the tag labels below. %>
    <% body_html = format_body(entry.formatted_body) %>
    <% body_html = link_hashtags(body_html) if current_user.is_pro? %>
    <% if @search.present? %>
      <%= highlight(body_html, @search.term) %>
    <% elsif entry.formatted_body.present? %>
      <%= body_html %>
    <% else %>
      <div class="text-muted text-center" style="margin: 25px 0;">Entry has no content.</div>
    <% end %>

    <% if current_user.is_pro? %>
      <%= entry.spotify_embed %>
    <% end %>
    <% if current_user.is_pro? && (hashtags = entry.hashtags).present? %>
      <p class="tags">
        <span class="slab-icon slab-icon--tag" aria-hidden="true"></span><span class="sr-only">Tags:</span>
        <% hashtags.each do |tag| %>
          <% tag_obj = @hashtags.present? ? @hashtags[tag.downcase] : current_user.original_hashtags.find { |h| h.tag&.downcase == tag.downcase } %>
          <% if tag_obj&.date.present? %>
            <%= link_to search_url(host: ENV['MAIN_DOMAIN'], search: {term: "##{tag}"}), class: "noline", rel: "tooltip-mobile-friendly", title: "#{tag_relative_date(tag_obj.date, entry.date)}", style: "display: inline-block; margin-top: 8px;" do %>
              <span class="label label-default"><%= tag %></span>
            <% end %>
          <% else %>
            <%= link_to search_url(host: ENV['MAIN_DOMAIN'], search: {term: "##{tag}"}), class: "noline", style: "display: inline-block; margin-top: 8px;" do %>
              <span class="label label-default"><%= tag %></span>
            <% end %>
          <% end %>
        <% end %>
      </p>
    <% end %>
  </div>

  <% if entry.display_image_url.present? %>
    <div class="pictureFrame">
      <%= link_to entry.display_image_url(cloudflare: false), target: "_blank" do %>
        <%= image_code(entry) %>
      <% end %>
      <% if entry.uploading_image? && params[:action] != "index" %>
        <script>
          setTimeout(function() { location.reload(); }, 4500);
        </script>
      <% end %>
    </div>
  <% end %>
  <% if entry.image_error.present? && !entry.uploading_image? && params[:action] != "index" %>
    <div class="alert alert-danger" style="margin-top: 10px; position: relative;">
      <strong>Image upload failed.</strong>
      <br>
      <%= entry.image_error %>
      <br>
      <small class="text-muted">Try re-uploading via the <%= link_to "edit page", edit_entry_path(entry) %>.</small>
      <%= button_to dismiss_entry_image_error_path(entry), method: :delete, class: "close", style: "position: absolute; top: 8px; right: 12px; background: transparent; border: 0; font-size: 20px; line-height: 1; padding: 0; cursor: pointer;", "aria-label": "Dismiss" do %>
        <span aria-hidden="true">&times;</span>
      <% end %>
    </div>
  <% end %>
  <div class="clearfix"></div>

  <script>
    $("#entry-<%= entry.id %>").imagesLoaded()
      .done( function( instance ) {
        $(instance.elements).find('.pictureFrame img').css("background-image","none");
      });
  </script>
<% end %>

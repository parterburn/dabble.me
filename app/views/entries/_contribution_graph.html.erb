<div class="table-container">
  <div class="contribution-graph">
    <div class="month-labels" style="display: grid; font-size: 11px; color: #999; font-weight: 600; text-transform: uppercase; padding-bottom: 5px;">
      <div class="day-label" style="text-align: center;"></div>
      <% (1..12).each do |month| %>
        <div style="text-align: center;"><%= Date::ABBR_MONTHNAMES[month] %></div>
      <% end %>
    </div>

    <div class="graph" style="grid-auto-flow: column; display: grid; grid-template-rows: repeat(7, 1fr); width: 100%;">
      <% data_by_day = data.index_by { |d| d[:day] } %>
      <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %>
        <% if day.in?(%w[Mon Wed Fri]) %>
          <div class="day-label" style="line-height: 0px; text-align: center; text-transform: uppercase; font-size: 10px; color: #999; font-weight: 600; padding-right: 5px; margin-top: 6px;"><%= day %></div>
        <% else %>
          <div class="day-label" style="line-height: 0px; text-align: center; text-transform: uppercase; font-size: 10px; color: #999; font-weight: 600; padding-right: 5px; margin-top: 6px;">&nbsp;</div>
        <% end %>
      <% end %>

      <% (1..380).each do |day| %>
        <% date = Date.ordinal(year.to_i, day) rescue nil %>

        <% if date %>
          <% if day == 1 && date.wday != 0 %>
            <% (0..date.wday - 1).each do %>
              <div style="margin: 0 auto;"></div>
            <% end %>
          <% end %>

          <% day_data = data_by_day[day] %>
          <% if day_data && day_data[:has_entry] %>
            <% streak_text = day_data[:streak] > 2 ? "#{day_data[:streak]} day streak! " : "" %>
            <div style="margin: 0 auto;" rel="tooltip" title="<%= streak_text %>Entry on <%= day_data[:date].strftime('%a, %b %-d') %>">
              <%= link_to day_entry_path(year: day_data[:date].year, month: day_data[:date].month, day: day_data[:date].day), class: "day", title: "Entry on #{day_data[:date].strftime('%B %-d, %Y')}#{streak_text}", target: "_blank" do %>
                <div class="box active <%= 'streak' if day_data[:streak] > 2 %>" style="margin: 0 auto;"></div>
              <% end %>
            </div>
          <% elsif date %>
            <% user_today = @user_today || Time.now.in_time_zone(current_user.send_timezone.presence || "UTC").to_date %>
            <% is_future = date >= user_today %>
            <div style="margin: 0 auto;" rel="tooltip" title="<%= 'No entry on ' unless is_future %><%= date.strftime('%a, %b %-d') %>">
              <%= link_to new_entry_path(day: date.strftime('%Y-%m-%d')), class: "day", title: "#{is_future ? 'Future date' : 'No entry'} on #{date.strftime('%B %-d, %Y')}", target: "_blank" do %>
                <div class="box" style="margin: 0 auto; <%= 'opacity: 0.5;' if is_future %>"></div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

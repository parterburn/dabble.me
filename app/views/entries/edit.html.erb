<% title "Edit Entry on #{@entry.date_format_long}" %>
<% add_class = 'blur' if current_user.is_free? %>

<div class="row">
  <br>
  <% if current_user.is_free? %>
    <div class="col-md-8 col-md-offset-2">
      <div class="alert alert-warning">
        <%= link_to "Subscribe to PRO", subscribe_path, class: "alert-link" %>
        to unlock the ability to edit entries.
      </div>
    </div>
  <% end %>

  <div class="col-md-8 col-md-offset-2 well s-new-edit-entry" id="entry-<%= @entry.id %>">
    <div>
      <div class="s-entry-date s-new-entry">
        <% if @entry.inspiration.present? %>
          <div class="float-left s-edit-entry" rel="popover" title="<%= @entry.inspiration.inspired_by %>" data-content="<%= @entry.inspiration.body.html_safe %>">
            <i class="fa fa-lightbulb-o"></i>
          </div>
        <% end %>
        <h2><%= @entry.date_format_short %></h2>
        <h3>
          <span>
            <%= @entry.date_day.upcase %>
          </span>
        </h3>
      </div>

      <%= form_for :entry, url: entry_path(@entry), method: :patch, html: { toolname: "update_journal_entry", tooldescription: "Update the signed-in user's private journal entry on this page. Fill the date and body, then leave the form for the user to review and submit." } do |f| %>

        <% if @entry.errors.any? %>
          <div id="error_explanation">
            <div class="alert alert-danger">
              <% @entry.errors.full_messages.each do |msg| %>
                <p><%= msg %></p>
              <% end %>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.label :date %>
          <div class="input-group date">
            <span class="input-group-addon">
              <i class="fa fa-calendar"></i>
            </span>
            <%= f.text_field :date, value: @entry.date_format_short, placeholder: "October 11 2014", class: "form-control pickadate", toolparamdescription: "Entry date, such as July 17, 2026." %>
          </div>
          <br>
        </div>

        <div class="<%= add_class %>">

          <% if @entry.image.present? %>
            <label>
              <%= f.check_box :remove_image, class: 'j-image-remove' %>
              &nbsp;Remove Photo
            </label>
            <br>
            <div class="pictureFrame editable j-image-preview">
              <%= link_to @entry.display_image_url(cloudflare: false), target: "_blank" do %>
                <%= image_code(@entry) %>
              <% end %>
            </div>
          <% else %>
            <%= f.label :image, "Photo" %>
            <%= f.file_field :image, accept: Entry::ALLOWED_IMAGE_TYPES.join(","), multiple: true %>
          <% end %>
          <br>
        </div>

        <div class="<%= add_class %>">
          <%= f.label :entry %>
          <%= f.text_area :entry, class: "form-control summernote", rows: 15, value: format_body(@entry.formatted_body), toolparamdescription: "Updated journal entry body." %>
        </div>

        <div>
          <%= f.submit "Update Entry", class: "form-control btn btn-primary" %>
        </div>
      <% end %>

      <div class="delete-entry-action">
        <%= link_to "Delete Entry", entry_path(@entry), class: "s-delete", method: :delete, data: { confirm: 'Are you sure you want to delete this entry? There is no undo.' } %>
      </div>
    </div>
  </div>
</div>

<script>
  var summer_note = $('#entry_entry');
  summer_note.summernote({
    mode: 'text/html',
    height: 300,
    theme: 'flatly',
    disableDragAndDrop: true,
    tabDisable: false,
    focus: true,
    toolbar: [["style", ["bold", "italic", "underline", "clear"]], ["layout", ["ul", "ol"]], ['insert', ['link']], ['misc', ['fullscreen', 'codeview']]]
  });

  summer_note.summernote("code", summer_note.val())
  summer_note.closest('form').submit(function() {
    summer_note.val(summer_note.summernote("code"));
    return true;
  });

  $("#entry-<%= @entry.id %>").imagesLoaded()
    .done( function( instance ) {
      $(instance.elements).find('.pictureFrame img').css("background-image","none");
    });

  $("#entry_image").on("change", function() {
    if ($("#entry_image")[0].files.length > <%= CollageGenerator::MAX_IMAGES %>) {
        alert("Photos are limited to <%= CollageGenerator::MAX_IMAGES %> per entry.");
    }
  });
</script>

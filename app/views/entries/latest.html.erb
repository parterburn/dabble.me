<% if @has_entries %>
  <% title "Today — Dabble me." %>
  <% graph_year = @user_today.year %>
  <% review_year = @user_today.month > 11 ? @user_today.year : @user_today.year - 1 %>
  <% highlight_year_in_review = @user_today > Date.parse("#{review_year}-12-1") && @user_today < Date.parse("#{review_year + 1}-01-15") %>

  <div class="row">
    <%= render "sidebar", dashboard: true %>

    <% year_entries = current_user.entries.where("date >= '#{graph_year}-01-01'::DATE AND date <= '#{graph_year}-12-31'::DATE") %>
    <%= javascript_include_tag "//www.gstatic.com/charts/loader.js", "chartkick" %>
    <% total_count = year_entries.count %>
    <% days_with_entries = year_entries.where("date <= ?", @user_today).distinct.count(:date) %>
    <% percent_with_entries = (days_with_entries.to_f / elapsed_days_in_year(graph_year) * 100).round %>

    <% if @today_entry %>
      <div class="col-md-8 well entry entry--sticky-header col-md-offset-1" id="entry-<%= @today_entry.id %>" style="margin-top: 30px;">
        <%= render partial: 'entries/entry', locals: { entry: @today_entry, label: "TODAY" } %>
      </div>
    <% else %>
      <div class="col-md-8 well col-md-offset-1 entry" style="margin-top: 30px;">
        <div class="center">
          <div class="label label-past-years" style="text-transform: uppercase;"><%= @user_today.strftime("%A, %B %-d") %></div>
        </div>
        <div class="text-center" style="margin: 0 0 20px;">
          <%= link_to "Write today's entry »", new_entry_path, class: "btn btn-link btn-lg" %>
        </div>
      </div>
    <% end %>

    <div class="col-md-8 well col-md-offset-1" id="year-in-review" style="padding-top: 0; padding-left: 0; padding-right: 0;">
      <div class="center">
        <div class="s-entry-date">
          <h2>
            <%= link_to "Year in Progress", rewind_path %>
          </h2>
          <h3>
            <span rel="tooltip" title="<%= percent_with_entries %>% of days so far in <%= graph_year %> have entries."><%= "#{total_count} entries in #{graph_year}" %></span>
          </h3>
        </div>
        <div class="s-review-details">
          <%= render 'contribution_graph', data: contribution_calendar_data(year_entries, graph_year), year: graph_year, new_tab: false %>
          <div class="clearfix"></div>
          <% if highlight_year_in_review %>
            <h4 style="font-size: 16px; margin-top: 10px; font-weight: 600;">
              <span>See more stats in your </span>
              <%= link_to "#{review_year} Rewind", rewind_path, style: "color: #649cc7;" %><span>!</span>
            </h4>
          <% end %>
        </div>
      </div>
    </div>

    <% if current_user.is_pro? && @years_ago_entries.present? %>
      <% @years_ago_entries.each do |_years_back, back_year_entry| %>
        <div class="col-md-8 col-md-offset-1 well entry entry--sticky-header" id="entry-<%= back_year_entry.id %>">
          <%= render partial: 'entries/entry', locals: { entry: back_year_entry } %>
        </div>
      <% end %>
    <% end %>
  </div>

<% else %>
  <%= render partial: 'no_entries' %>
<% end %>

<% if user_signed_in? %>
  <div class="well <%= add_class %>">
    <div class="center">
      <div class="s-entry-date">
        <h2>Looking for ideas?</h2>
        <h3>
          <span>
            <span class="slab-icon slab-icon--lightbulb" aria-hidden="true"></span>
          </span>
        </h3>
      </div>
    </div>
    <div class="s-scrollable">
      <div class="entry-panel">
        <%= ApplicationHelper.faq("ideas-for-writing")[:a].html_safe %>
      </div>
    </div>
    <div class="clearfix"></div>
  </div>

  <%= render "entries/premium_features", add_class: add_class %>  
<% end %>

<div class="col-md-8 col-md-offset-1">
  <br>
  <%= form_for Search.new(), url: search_path, method: :get, html: { class: "form-horizontal", toolname: "search_journal", tooldescription: "Search the signed-in user's private Dabble Me journal. Fill the query and leave the form for the user to submit." } do |f| %>
    <div class="s-search-row s-search-row--edge">
      <div class="s-search-row__field">
        <%= f.text_field :term, class: "form-control input-lg s-search-with-clear", autofocus: true, placeholder: "Search your entries...", toolparamdescription: "Keyword, topic, or quoted phrase to find in journal entries." %>
      </div>
      <%= f.submit "Search", class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>

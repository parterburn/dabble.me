<% title 'Unsubscribe from updates — Dabble me.' %>
<% content_for :tailwind, true %>

<div class="tw mx-auto max-w-2xl pt-4 pb-16 sm:pt-8">
  <header class="mb-8">
    <h1 class="font-serif text-4xl tracking-tight text-primary sm:text-5xl">Unsubscribe from updates</h1>
    <p class="mt-2 text-muted">For <%= @user.first_name.presence || @user.masked_email %></p>
  </header>

  <section class="card p-6 sm:p-8">
    <p class="text-primary">
      Updates are the occasional letter about what's new in Dabble Me. Your journal emails are a separate setting and won't change.
    </p>
    <%= button_to "Unsubscribe from updates", email_updates_path(token: params[:token]), method: :post, class: "button-primary mt-5 w-full sm:w-auto" %>
  </section>
</div>

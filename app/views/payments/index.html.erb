<% title "Payments — Dabble me." %>

<div class="row">
  <div class="col-md-2">
    <p>
      <%= link_to "Add new payment", new_payment_path, class: "btn btn-info" %>
    </p>
  </div>
  <div class="col-md-6">
    <p>
      <strong>
        Total Payments:
        <%= number_with_delimiter(@payments.length) %>
        for
        <%= number_to_currency(@cash_total) %>
      </strong>
    </p>
    <p class="text-muted">
      This page is the payment ledger.
      Recurring revenue (MRR / ARR) is on
      <%= link_to "Admin Stats", admin_stats_path %>.
    </p>
  </div>
</div>

<div class="row">
  <div class="col-md-1">
    <h4>Actions</h4>
  </div>
  <div class="col-md-2">
    <h4>Date</h4>
  </div>
  <div class="col-md-1">
    <h4>Amount</h4>
  </div>
  <div class="col-md-3">
    <h4>User</h4>
  </div>
  <div class="col-md-2">
    <h4>Plan</h4>
  </div>
  <div class="col-md-3">
    <h4>Comments</h4>
  </div>
</div>

<% @paginated_payments.each do |payment| %>
  <div class="row s-inspiration-admin">
    <div class="col-md-1">
      <%= link_to edit_payment_path(payment), class: "noline", title: "Edit Payment" do %>
        <i class="fa fa-pencil"></i>
      <% end %>
      &nbsp;
      <%= link_to payment_path(payment), title: "Delete Payment", class: "s-delete", method: :delete, data: { confirm: 'Are you sure you want to delete this payment? There is no undo.' } do %>
        <i class="fa fa-trash"></i>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= payment.date.strftime("%Y-%m-%d") %>
    </div>
    <div class="col-md-1">
      <%= number_to_currency(number_with_delimiter(payment.amount)) %>
    </div>
    <div class="col-md-3">
      <% if payment.user %>
        <%= payment.user.email %>
      <% else %>
        <%= payment.user_id %>
      <% end %>
    </div>
    <div class="col-md-2">
      <% if payment.user %>
        <%= payment.user.plan %>
      <% end %>
    </div>
    <div class="col-md-3">
      <%= payment.comments %>
    </div>
  </div>
<% end %>

<div class="row">
  <div class="col-md-12">
    <div class="center">
      <%= paginate @paginated_payments %>
    </div>
  </div>
</div>

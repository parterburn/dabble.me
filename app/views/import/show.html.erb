<%# Sources entries can be imported from. The page with no type is the
    chooser; each type shows its own form below it. %>
<% sources = [
     { key: "day_one", name: "Day One", blurb: "The ZIP from Day One's JSON export, photos included." },
     { key: "ohlife", name: "OhLife", blurb: "Paste the text from your OhLife export." },
     { key: "photos", name: "OhLife photos", blurb: "A ZIP of the photos from your OhLife export." },
     { key: "ahhlife", name: "Ahhlife", blurb: "Paste your Ahhlife JSON." },
     { key: "trailmix", name: "Trailmix.life", blurb: "Upload your Trailmix JSON file." }
   ] %>
<% source = sources.find { |s| s[:key] == params[:type].to_s.downcase } %>
<% title source ? "Import from #{source[:name]} — Dabble me." : "Import entries — Dabble me." %>
<% content_for :tailwind, true %>
<% free = current_user.is_free? %>

<div class="tw mx-auto max-w-2xl pt-4 pb-16 sm:pt-8">
  <header class="mb-8">
    <h1 class="font-serif text-4xl tracking-tight text-primary sm:text-5xl">Import entries</h1>
    <p class="mt-2 text-muted">Bring your journal with you. Entries from another app land on the days you wrote them, next to everything you write here.</p>
  </header>

  <div class="space-y-6">
    <% if free %>
      <section class="card flex flex-wrap items-center justify-between gap-4 p-5">
        <p class="text-primary"><strong>Dabble Me PRO</strong> ($4/mo) unlocks importing from other services.</p>
        <%= link_to "Subscribe now", subscribe_path, class: "button-primary" %>
      </section>
    <% end %>

    <section>
      <h2 class="font-serif text-2xl text-primary">Where are your entries coming from?</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <% sources.each do |s| %>
          <% current = s == source %>
          <%= link_to import_path(s[:key]), class: "card block p-4 no-underline transition-colors hover:bg-surface-elevated #{'ring-2 ring-accent' if current}", "aria-current": (current ? "page" : nil) do %>
            <span class="block font-medium text-primary"><%= s[:name] %></span>
            <span class="mt-1 block text-sm text-muted"><%= s[:blurb] %></span>
          <% end %>
        <% end %>
      </div>
    </section>

    <% if source %>
      <%# inert keeps a free account from using a form it can only look at. %>
      <section id="import-form" class="card p-6 sm:p-8 <%= 'opacity-50' if free %>" <%= "inert" if free %>>
        <h2 class="font-serif text-2xl text-primary">Import from <%= source[:name] %></h2>

        <% case source[:key] %>
        <% when "day_one" %>
          <ol class="mt-4 list-decimal space-y-1 pl-5 text-muted">
            <li>In Day One, export your journal as <strong class="text-primary">JSON</strong>. Include media if you want your photos.</li>
            <li>Upload the ZIP Day One creates, without unzipping it.</li>
          </ol>
          <%= form_tag(import_process_path(type: "day_one"), multipart: true, method: :put, class: "mt-5") do %>
            <%= label_tag "zip_file", "Day One export (ZIP)", class: "field-label" %>
            <%= file_field_tag "zip_file", accept: ".zip,application/zip", class: "field-input" %>
            <%= submit_tag "Upload Day One ZIP", class: "button-primary mt-5" %>
          <% end %>
          <p class="mt-5 text-sm text-muted">
            The ZIP should hold a <code>.json</code> file and, if you included media, a <code>photos/</code> folder.
            Several entries on one day become one Dabble Me entry. Days you've already written here are left as they are.
          </p>

        <% when "photos" %>
          <%= form_tag(import_ohlife_images_path, multipart: true, class: "mt-5") do %>
            <%= label_tag "zip_file", "ZIP file of photos", class: "field-label" %>
            <%= file_field_tag "zip_file", class: "field-input" %>
            <%= submit_tag "Upload ZIP File", class: "button-primary mt-5" %>
          <% end %>
          <p class="mt-5 text-sm text-muted">
            This works best with ZIP files under 20 MB holding fewer than 20 photos, so you may need to split the ZIP from OhLife into smaller ones.
            Filenames should look like <code>img_2014-10-22-0.jpg</code>.
          </p>

        <% when "trailmix" %>
          <%= form_tag(import_process_path(type: "trailmix"), multipart: true, method: :put, class: "mt-5") do %>
            <%= label_tag "json_file", "JSON file of entries", class: "field-label" %>
            <%= file_field_tag "json_file", class: "field-input" %>
            <%= submit_tag "Upload JSON File", class: "button-primary mt-5" %>
          <% end %>
          <p class="mt-5 text-sm text-muted">
            The file should look like this:
            <code class="mt-1 block break-all">[{"body": "Your entry here...", "date": "YYYY-MM-DD"}]</code>
          </p>

        <% else %>
          <% placeholder = if source[:key] == "ahhlife"
                             '{"Jul-2015": {"-JtqbI_fF_2348SFrMqPQ": {"content": "Your entry here...","timestamp": 1436486400000}}}'
                           else
                             "2014-10-02\n\nHere's my first entry!\n\nYYYY-MM-DD\n\nEntry text exactly 2 line-breaks after date."
                           end %>
          <%= form_for :entry, url: import_process_path(type: source[:key]), method: :put, html: { class: "mt-5" } do |f| %>
            <%= f.label :text, (source[:key] == "ahhlife" ? "Your Ahhlife JSON" : "Your OhLife export"), class: "field-label" %>
            <%= f.text_area :text, rows: 10, placeholder: placeholder, class: "field-input font-mono text-sm" %>
            <%= f.submit "Import Entries", class: "button-primary mt-5" %>
          <% end %>
          <% if source[:key] == "ohlife" %>
            <p class="mt-5 text-sm text-muted">
              Each entry starts with its date as <code>YYYY-MM-DD</code>, then a blank line, then the text.
              Have photos too? Use the <%= link_to "OhLife photo importer", import_path("photos"), class: "text-link" %>.
            </p>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <p class="text-sm text-muted">
      Want a copy of what's here instead? <%= link_to "Export entries", export_entries_path, class: "text-link" %>.
    </p>
  </div>
</div>

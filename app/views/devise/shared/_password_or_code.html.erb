<%# Where a change is confirmed: the current password, or, for an account with none (made by
    email code), a code emailed to it (EmailCode.confirm). "Email me a code" submits this same
    form to ConfirmationCodesController, which sends one and comes back here.
    locals: f (the form builder), label, help (optional). %>
<% if current_user.has_password? %>
  <%= f.label :current_password, label, class: "field-label" %>
  <%= f.password_field :current_password, autocomplete: "current-password", class: "field-input" %>
<% else %>
  <%= label_tag "user_email_code", "Code from your email", class: "field-label" %>
  <div class="flex flex-wrap gap-3">
    <%= text_field_tag "user[email_code]", nil, id: "user_email_code", autocomplete: "one-time-code", inputmode: "numeric", maxlength: 7, placeholder: "123456", class: "field-input max-w-[12rem] font-mono tracking-widest" %>
    <button type="submit" class="button-secondary" formaction="<%= confirmation_code_path %>" formmethod="post" formnovalidate>Email me a code</button>
  </div>
  <p class="field-help">Your account has no password, so we confirm changes with a code sent to <%= current_user.email %>.</p>
<% end %>
<% if local_assigns[:help] %>
  <p class="field-help"><%= help %></p>
<% end %>

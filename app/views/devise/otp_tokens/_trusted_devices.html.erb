<h4><%= I18n.t('title', :scope => 'devise.otp.trusted_browsers') %></h4>
<p><%= I18n.t('explain', :scope => 'devise.otp.trusted_browsers') %></p>

<%- if is_otp_trusted_browser_for? resource %>
  <p><em class="text-success"><%= I18n.t('browser_trusted', :scope => 'devise.otp.trusted_browsers') %></em></p>
  <p><%= button_to I18n.t('trust_remove', :scope => 'devise.otp.trusted_browsers'), otp_persistence_path_for(resource_name), :method => :delete, class: "btn btn-default" %></p>
<% else %>
  <p><%= I18n.t('browser_not_trusted', :scope => 'devise.otp.trusted_browsers') %></p>
  <p><%= button_to I18n.t('trust_add', :scope => 'devise.otp.trusted_browsers'), otp_persistence_path_for(resource_name), :method => :post, class: "btn btn-default" %></p>
<% end %>

<p><%= button_to I18n.t('trust_clear', :scope => 'devise.otp.trusted_browsers'), reset_otp_persistence_path_for(resource_name), :method => :delete, class: "btn btn-warning" %></p>

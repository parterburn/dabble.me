<% current_user.generate_otp_secret unless current_user.otp_auth_secret? %>

<div class="space-y-6">
  <% if current_user.otp_enabled? %>
    <% if recovery_enabled? && current_user.otp_enabled_on > 10.minutes.ago %>
      <section class="card p-6 sm:p-8">
        <h2 class="font-serif text-2xl text-primary"><%= I18n.t('title', scope: 'devise.otp.otp_tokens.recovery') %></h2>
        <p class="mt-1 text-sm text-muted"><%= I18n.t('explain', scope: 'devise.otp.otp_tokens.recovery') %></p>
        <div id="recovery-codes" class="mt-5 grid grid-cols-2 gap-x-6 gap-y-1 rounded-lg border border-subtle bg-surface-elevated p-4 font-mono text-sm text-primary sm:grid-cols-3">
          <% current_user.next_otp_recovery_tokens.each do |_seq, code| %>
            <span><%= code %></span>
          <% end %>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="button" class="button-secondary j-copy-to-clipboard" data-content="<%= current_user.next_otp_recovery_tokens.map { |_, code| code }.join("\n") %>">
            <span class="slab-icon slab-icon--copy" aria-hidden="true"></span> Copy to clipboard
          </button>
          <%= link_to I18n.t('download_codes', scope: 'devise.otp.otp_tokens.recovery'), recovery_otp_token_for(resource_name, format: :text), class: "button-secondary" %>
        </div>
      </section>
    <% end %>

    <%= render partial: 'trusted_devices' if trusted_devices_enabled? %>

    <section class="rounded-xl border border-red-200 bg-surface p-6 sm:p-8">
      <h2 class="font-serif text-2xl text-red-800"><%= I18n.t('reset_otp', scope: 'devise.otp.token_secret') %></h2>
      <p class="mt-1 text-sm text-muted">
        <%= I18n.t('reset_explain', scope: 'devise.otp.token_secret') %>
        <strong class="font-semibold text-primary"><%= I18n.t('reset_explain_warn', scope: 'devise.otp.token_secret') %></strong>
      </p>
      <%= button_to I18n.t('reset_otp', scope: 'devise.otp.token_secret'), @resource, method: :delete, data: { "turbo-method": "DELETE" }, class: "button-danger mt-5", form_class: "contents" %>
    </section>
  <% else %>
    <section class="card p-6 sm:p-8">
      <p class="font-medium text-primary"><%= I18n.t('explain', scope: 'devise.otp.token_secret') %></p>
      <div class="mt-5 inline-block overflow-hidden rounded-lg border border-subtle">
        <%= otp_authenticator_token_image(current_user) %>
      </div>
    </section>

    <section class="card p-6 sm:p-8">
      <%= form_for(current_user, as: resource_name, url: validate_otp_path, html: { method: :post, "data-turbo" => false, class: "space-y-5" }) do |f| %>
        <%= f.hidden_field :challenge, value: @challenge %>
        <%= f.hidden_field :recovery, value: @recovery %>

        <div class="space-y-3">
          <% if @recovery %>
            <%= f.label :token, I18n.t('recovery_prompt', scope: 'devise.otp.submit_token'), class: "field-label" %>
            <%= f.text_field :otp_recovery_counter, autocomplete: :off, disabled: true, size: 4, class: "field-input" %>
            <%= f.text_field :token, autocomplete: :off, autofocus: true, size: 6, value: '', class: "field-input" %>
          <% else %>
            <%= f.label :token, "Step 2: #{I18n.t('prompt', scope: 'devise.otp.submit_token')}", class: "field-label" %>
            <%= f.text_field :token, autocomplete: "one-time-code", inputmode: "numeric", autofocus: true, size: 6, value: '', class: "field-input" %>
          <% end %>
        </div>

        <%= f.submit "Enable Two-Factor Authentication", class: "button-primary w-full" %>
      <% end %>
    </section>
  <% end %>
</div>

<% title "Two-Factor Authentication" %>
<% content_for :tailwind, true %>

<div class="tw mx-auto max-w-2xl pt-4 pb-16 sm:pt-8">
  <%= link_to "← Back to Account security", security_path, class: "text-sm text-muted hover:text-primary" %>

  <header class="mt-4 mb-8">
    <h1 class="font-serif text-4xl tracking-tight text-primary sm:text-5xl"><%= I18n.t('title', scope: 'devise.otp.otp_tokens') %></h1>
    <p class="mt-2 text-muted"><%= I18n.t('explain', scope: 'devise.otp.otp_tokens') %></p>
  </header>

  <%= render partial: 'token_secret' %>
</div>

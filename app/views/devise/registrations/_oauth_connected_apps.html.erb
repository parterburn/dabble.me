<section class="card p-6 sm:p-8">
  <h2 class="flex items-center gap-2 font-serif text-2xl text-primary">
    <span class="slab-icon slab-icon--cloud text-xl" aria-hidden="true"></span>
    Connected apps
  </h2>

  <% if @oauth_applications.any? %>
    <p class="mt-1 text-sm text-muted">These tools can call Dabble Me on your behalf until you revoke them.</p>
    <ul class="mt-5 divide-y divide-cream-300 rounded-lg border border-subtle">
      <% @oauth_applications.each do |application| %>
        <li class="flex items-center justify-between gap-4 px-4 py-3">
          <div class="min-w-0">
            <p class="truncate font-medium text-primary"><%= application.name %></p>
            <p class="text-sm text-muted">Added <%= application.created_at.strftime("%b %d, %Y") %></p>
          </div>
          <%= link_to "Remove", oauth_authorized_application_path(application), method: :delete, data: { confirm: "Are you sure?" }, class: "shrink-0 text-sm font-medium text-red-700 hover:text-red-800 hover:underline" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-1 text-sm text-muted">
      Connect to apps like Claude or ChatGPT using the <%= link_to "Dabble Me MCP server", mcp_server_docs_path, class: "text-link font-medium" %>.
    </p>
  <% end %>
</section>

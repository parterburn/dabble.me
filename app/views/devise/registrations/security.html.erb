<% title 'Account security — Dabble me.' %>
<% content_for :tailwind, true %>

<div class="tw mx-auto max-w-2xl pt-4 pb-16 sm:pt-8">
  <header class="mb-8">
    <h1 class="font-serif text-4xl tracking-tight text-primary sm:text-5xl">Account security</h1>
    <p class="mt-2 text-muted">Your email, password, passkeys, two-factor authentication, where you're signed in, and connected apps.</p>
  </header>

  <%# Jump links, so Sessions and Connected apps (below the form) are one tap away. A count
      shows only when there's something there. %>
  <% security_sections = [
       ["Email and password", "email-password", nil],
       ["Passkeys", "passkeys", current_user.webauthn_credentials.size],
       ["Sessions", "sessions", @user_sessions.length],
       ["Connected apps", "connected-apps", @oauth_applications.size]
     ] %>
  <nav aria-label="Sections on this page" class="-mt-3 mb-8">
    <ul class="flex flex-wrap gap-2">
      <% security_sections.each do |label, anchor, count| %>
        <li>
          <a href="#<%= anchor %>" class="inline-flex items-center gap-1.5 rounded-full border border-subtle bg-surface px-3.5 py-1.5 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-elevated hover:text-primary focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none">
            <%= label %>
            <% if count.to_i.positive? %>
              <span class="min-w-5 rounded-full bg-cream-200 px-1.5 text-center text-xs font-semibold tabular-nums text-muted"><%= count %></span>
            <% end %>
          </a>
        </li>
      <% end %>
    </ul>
  </nav>

  <%= form_for(user, url: registration_path(user), html: { method: :put, class: "space-y-6" }) do |f| %>
    <section class="card scroll-mt-4 p-6 sm:p-8" id="email-password">
      <h2 class="font-serif text-2xl text-primary">Email and password</h2>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :email, class: "field-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "field-input" %>
          <% if current_user.pending_email.present? %>
            <p class="field-help">
              Waiting for the code sent to <strong class="break-all"><%= current_user.pending_email %></strong>.
              <%= link_to "Enter it", email_change_path, class: "text-accent underline hover:text-primary" %>
            </p>
          <% else %>
            <p class="field-help">A change takes effect once you enter a code we email to the new address.</p>
          <% end %>
        </div>
        <div>
          <%= f.label :password, current_user.has_password? ? "New password" : "Set a password (optional)", class: "field-label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "field-input" %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
        </div>
      </div>
    </section>

    <section class="card scroll-mt-4 p-6 sm:p-8" id="passkeys">
      <h2 class="font-serif text-2xl text-primary">Passkeys and two-factor</h2>
      <p class="mt-1 text-sm text-muted">More ways to keep your journal safe when you log in.</p>

      <div class="mt-5 flex flex-wrap gap-3">
        <button class="button-secondary" id="add-passkey" type="button" data-proof-needed="<%= passkey_proof_needed? %>">Add Passkey</button>
        <%= link_to user_otp_token_path, id: "add-two-factor", class: "button-secondary" do %>
          <% if current_user.otp_enabled? %>
            <span class="slab-icon slab-icon--check text-green-700" aria-hidden="true"></span>
            Change Two-Factor Authentication
          <% else %>
            Set Up Two-Factor Authentication
          <% end %>
        <% end %>
      </div>

      <% if current_user.webauthn_credentials.any? %>
        <ul class="mt-5 divide-y divide-cream-300 rounded-lg border border-subtle">
          <% current_user.webauthn_credentials.each do |credential| %>
            <li class="flex items-center justify-between gap-4 px-4 py-3">
              <div class="min-w-0">
                <p class="truncate font-medium text-primary"><%= credential.nickname %></p>
                <p class="text-sm text-muted">Added <%= credential.created_at.strftime("%b %d, %Y") %></p>
              </div>
              <% if current_user.admin? %>
                <%# AdminAccounts: an admin's passkeys are removed from the Rails console only. %>
                <span class="shrink-0 text-sm text-muted">Admin passkey</span>
              <% else %>
                <%= link_to "Remove", passkeys_registration_path(credential), method: :delete, data: { confirm: "Are you sure?" }, class: "shrink-0 text-sm font-medium text-red-700 hover:text-red-800 hover:underline" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="card p-6 sm:p-8">
      <%= render "devise/shared/password_or_code", f: f, label: "Current password",
                 help: (current_user.has_password? ? "Needed to change your email or password, or to add a passkey." : "Needed to change your email, set a password, or add a passkey.") %>
      <%= f.submit "Save Security Changes", class: "button-primary mt-5 w-full sm:w-auto j-edit-security", name: "submit_method", type: :submit %>
    </section>

    <%= render "signed_in_devices" %>
    <%= render "oauth_connected_apps" %>
  <% end %>

  <% unless current_user.admin? %>
    <p class="mt-8 text-center text-sm text-muted">
      To permanently delete your account and <%= pluralize(current_user.entries.count, "entry") %>,
      <%= link_to "use the delete account page", delete_account_path, class: "font-medium text-red-700 underline underline-offset-2 hover:text-red-800" %>.
    </p>
  <% end %>
</div>

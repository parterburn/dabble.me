<%# The top of the gift sign-up page (dabble.me/gift/<code>, Gift), in place of the usual header. %>
<div class="text-center mb-8">
  <span class="badge badge-accent dark:text-olive-800">A gift for you</span>
  <h1 class="mt-4 font-serif text-3xl sm:text-4xl tracking-tight text-primary">You've been given a year of PRO</h1>
  <p class="mt-3 text-muted">
    A one-year PRO subscription, a <%= Gift::VALUE %> value, is yours free. <%= user_signed_in? ? "Add it to your account" : "Create your account" %> to start journaling with everything PRO includes.
  </p>
</div>

<ul class="mb-8 grid gap-2 text-sm text-primary sm:grid-cols-2">
  <li class="flex items-start gap-2"><span class="text-accent" aria-hidden="true">✓</span> Emails on the days you choose</li>
  <li class="flex items-start gap-2"><span class="text-accent" aria-hidden="true">✓</span> Write and edit entries on the web</li>
  <li class="flex items-start gap-2"><span class="text-accent" aria-hidden="true">✓</span> Photos with your entries</li>
  <li class="flex items-start gap-2"><span class="text-accent" aria-hidden="true">✓</span> Search and hashtags across your journal</li>
</ul>

<p class="mb-6 text-center text-xs text-muted">
  No card needed. After a year your account moves to the free plan, and your entries stay yours (export included). You can subscribe at any time to restart PRO.
</p>

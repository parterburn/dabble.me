<% content_for :title, "A gift for you" %>
<% content_for :robots, "noindex, follow" %>

<%# dabble.me/gift/<code> for someone already signed in to a Free account. %>
<section class="py-12 lg:py-20">
  <div class="mx-auto max-w-xl px-4 sm:px-6">
    <%= render "devise/registrations/gift_header" %>

    <div class="card p-6 sm:p-8 text-center">
      <p class="text-muted">
        This adds the year of PRO to <span class="font-medium text-primary"><%= current_user.email %></span>.
      </p>
      <%= button_to "Add my year of PRO", redeem_gift_path(current_gift.code), method: :post,
            class: "mt-5 w-full px-6 py-3 text-sm font-medium rounded-lg bg-olive-900 text-white hover:bg-olive-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-olive-500 cursor-pointer transition-colors" %>
    </div>
  </div>
</section>

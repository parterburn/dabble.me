<% title "Edit #{@user.email_in_database} — Admin" %>
<% content_for :tailwind, true %>

<% content_for :admin_actions do %>
  <%= link_to "Payments", payments_path(user_id: @user.id), class: "button-secondary" %>
  <% if @user.stripe_id.present? %>
    <%= link_to "Stripe customer", stripe_dashboard_url("customers/#{@user.stripe_id}"), class: "button-secondary", target: "_blank", rel: "noopener" %>
  <% end %>
<% end %>

<div class="tw mx-auto max-w-6xl pt-4 pb-16 sm:pt-8">
  <%= render "admin/header", title: "Edit user", intro: @user.email_in_database %>

  <div class="grid gap-6 lg:grid-cols-[2fr_1fr]">
    <div class="card p-6 sm:p-8">
      <%= form_with model: @user, scope: :user, url: admin_user_path(@user), method: :patch, class: "space-y-5" do |f| %>
        <%= render "devise/shared/error_messages", resource: @user %>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :first_name, class: "field-label" %>
            <%= f.text_field :first_name, class: "field-input" %>
          </div>
          <div>
            <%= f.label :last_name, class: "field-label" %>
            <%= f.text_field :last_name, class: "field-input" %>
          </div>
        </div>

        <div>
          <%= f.label :email, class: "field-label" %>
          <%= f.email_field :email, class: "field-input" %>
          <p class="field-help">Changing it signs them out of the iOS app and connected AI apps<%= ", and updates their Stripe customer" if @user.stripe_id.present? %>.</p>
        </div>

        <fieldset>
          <legend class="field-label">Email days</legend>
          <%= hidden_field_tag "frequency[]", "", id: nil %>
          <div class="flex flex-wrap gap-4">
            <% Date::ABBR_DAYNAMES.each do |day| %>
              <label class="inline-flex items-center gap-2 text-sm text-primary">
                <%= check_box_tag "frequency[]", day, Array(@user.frequency).include?(day), id: "frequency_#{day}", class: "checkbox" %>
                <%= day %>
              </label>
            <% end %>
          </div>
          <p class="field-help">Free accounts get Sunday emails only. Untick every day to stop the emails.</p>
        </fieldset>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :send_time, class: "field-label" %>
            <%= f.select :send_time,
                  (0..23).map { |h| [Time.utc(2000, 1, 1, h).strftime("%-l %p"), format("%02d:00", h)] },
                  { selected: @user.send_time&.strftime("%H:00") }, class: "field-input" %>
          </div>
          <div>
            <%= f.label :send_timezone, "Timezone", class: "field-label" %>
            <%= f.time_zone_select :send_timezone, ActiveSupport::TimeZone.us_zones, {}, { class: "field-input" } %>
          </div>
        </div>

        <div>
          <%= f.label :plan, class: "field-label" %>
          <%= f.select :plan, plan_options(@user.plan_in_database, @user.plan), {}, class: "field-input" %>
          <p class="field-help">Billing IDs are on the payment form.</p>
        </div>

        <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center">
          <%= f.submit "Save", class: "button-primary" %>
          <%= link_to "Cancel", admin_users_path, class: "button-secondary" %>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="card p-6">
        <h2 class="font-serif text-2xl text-primary">Password</h2>
        <p class="mt-1 mb-4 text-sm text-muted">Emails them a link to choose a new password. Their current password keeps working until they use it.</p>
        <%= button_to "Send password reset", admin_user_password_reset_path(@user), method: :post, class: "button-secondary",
              data: { confirm: "Email a password reset link to #{@user.email_in_database}?" } %>
      </div>

      <div class="card p-6">
        <h2 class="font-serif text-2xl text-primary">Details</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-muted">User ID</dt><dd class="text-primary"><%= @user.id %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted">Joined</dt><dd class="text-primary"><%= @user.created_at&.strftime("%Y-%m-%d") %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted">Last sign-in</dt><dd class="text-primary"><%= @user.last_sign_in_at&.strftime("%Y-%m-%d") || "Never" %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted">Posting address</dt><dd class="truncate text-primary" title="<%= @user.user_key %>@<%= ENV['SMTP_DOMAIN'] %>"><%= @user.user_key %>@<%= ENV['SMTP_DOMAIN'] %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-muted">Paid</dt><dd class="text-primary"><%= link_to number_to_currency(@user.payments.sum(:amount)), payments_path(user_id: @user.id), class: "text-link" %></dd></div>
        </dl>
      </div>
    </div>
  </div>
</div>

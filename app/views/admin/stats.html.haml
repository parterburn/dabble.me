- title "Admin Stats"
- d = @dashboard
- r = d.revenue
- inv = d.inventory
= javascript_include_tag "//www.gstatic.com/charts/loader.js", "chartkick"

.s-stats
  .s-stats-header
    %div
      %h3 Admin Stats
      %p.s-stats-sub
        Live numbers for a five-minute check. The 6:00 UTC job snapshots yesterday so cash and email cover a full day. Snapshot now captures today.
        Weekly digest emails go to admin accounts on Monday.
    .s-stats-header__actions
      - if d.latest_snapshot
        %span.s-stats-meta Latest snapshot #{d.latest_snapshot.captured_on.strftime("%b %-d, %Y")}
      - else
        %span.s-stats-meta No snapshots yet
      = button_to "Snapshot now", capture_admin_stats_path, method: :post, class: "btn btn-default btn-sm", form_class: "s-stats-snapshot"

  - if d.attention_items.any?
    .s-stats-attention
      %h4 Needs attention
      %ul
        - d.attention_items.each do |item|
          %li= item

  %section.s-stats-section
    %h4 Decision bar
    .s-stats-kpis
      .s-stats-kpi
        .s-stats-kpi__label ARR
        .s-stats-kpi__value= d.format_cents(r.arr_cents)
        .s-stats-kpi__delta{ class: "is-#{d.delta_direction(d.arr_delta_week_cents)}" }
          #{d.format_delta(d.arr_delta_week_cents)} vs last week
      .s-stats-kpi
        .s-stats-kpi__label Toward $20k
        .s-stats-kpi__value= "#{d.arr_progress_percent}%"
        .s-stats-kpi__delta
          #{d.format_cents([RevenueMetrics::TARGET_ARR_CENTS - r.arr_cents, 0].max)} to go
      .s-stats-kpi
        .s-stats-kpi__label MRR
        .s-stats-kpi__value= d.format_cents(r.mrr_cents)
        .s-stats-kpi__delta{ class: "is-#{d.delta_direction(d.mrr_delta_cents)}" }
          #{d.format_delta(d.mrr_delta_cents)} vs yesterday
      .s-stats-kpi
        .s-stats-kpi__label Recurring subs
        .s-stats-kpi__value= number_with_delimiter(r.recurring_subscriber_count)
        .s-stats-kpi__delta
          #{number_with_delimiter(r.monthly_count)} monthly · #{number_with_delimiter(r.yearly_count)} yearly
      .s-stats-kpi
        .s-stats-kpi__label New MRR
        .s-stats-kpi__value= d.latest_snapshot ? d.format_cents(d.latest_snapshot.gross_new_mrr_cents) : "—"
        .s-stats-kpi__delta Latest snapshot
      .s-stats-kpi
        .s-stats-kpi__label Churned MRR
        .s-stats-kpi__value= d.latest_snapshot ? d.format_cents(d.latest_snapshot.churned_mrr_cents) : "—"
        .s-stats-kpi__delta Latest snapshot
      .s-stats-kpi
        .s-stats-kpi__label Net MRR
        .s-stats-kpi__value= d.net_new_mrr_cents ? d.format_cents(d.net_new_mrr_cents) : "—"
        .s-stats-kpi__delta{ class: "is-#{d.delta_direction(d.net_new_mrr_cents)}" }
          New minus churned
      .s-stats-kpi
        .s-stats-kpi__label This month ≈ $40/yr
        .s-stats-kpi__value= d.month_annual_equivalent.nil? ? "—" : d.month_annual_equivalent
        .s-stats-kpi__delta
          #{d.format_delta(d.month_net_arr_cents)} ARR this month

  %section.s-stats-section
    %h4 Pricing cohorts
    %p.s-stats-sub
      Legacy $3 / $30 plans stay grandfathered. New subscribers are $4 / $40. Lifetime is excluded from MRR.
    %table.table.table-striped.s-stats-table
      %thead
        %tr
          %th Cohort
          %th Count
          %th MRR
          %th ARR
      %tbody
        - d.pricing_cohorts.each do |cohort|
          %tr
            %td= cohort[:label]
            %td= number_with_delimiter(cohort[:count])
            %td= d.format_cents(cohort[:mrr_cents])
            %td= d.format_cents(cohort[:arr_cents])

  %section.s-stats-section
    %h4 Acquisition funnel
    %p.s-stats-sub Last 30 days of signups. 72-hour and 14-day rates use mature cohorts so they are not inflated by brand-new accounts.
    %table.table.table-striped.s-stats-table
      %thead
        %tr
          %th Step
          %th Count
          %th Of signups
          %th Of previous step
      %tbody
        - d.funnel_rows.each do |row|
          %tr
            %td= row[:label]
            %td= number_with_delimiter(row[:count])
            %td= d.format_rate(row[:of_signups])
            %td= row[:of_previous] ? d.format_rate(row[:of_previous]) : "—"
    %p.s-stats-sub
      72h first-entry activation: #{d.format_rate(d.first_entry_activation_rate)}.
      3 entries in 14 days: #{d.format_rate(d.three_entry_activation_rate)}.

  %section.s-stats-section
    %h4 Retention
    %p.s-stats-sub Wrote at least one entry in the window. This is standard WAU/MAU-style activity, not a full-year streak.
    %table.table.table-striped.s-stats-table
      %thead
        %tr
          %th Window
          %th PRO
          %th Free
      %tbody
        %tr
          %td 7 days
          %td= number_with_delimiter(d.retention[:pro_7d])
          %td= number_with_delimiter(d.retention[:free_7d])
        %tr
          %td 30 days
          %td= number_with_delimiter(d.retention[:pro_30d])
          %td= number_with_delimiter(d.retention[:free_30d])
        %tr
          %td 90 days
          %td= number_with_delimiter(d.retention[:pro_90d])
          %td= number_with_delimiter(d.retention[:free_90d])
        %tr
          %td 365 days
          %td= number_with_delimiter(d.retention[:pro_365d])
          %td= number_with_delimiter(d.retention[:free_365d])
    %p.s-stats-sub
      PRO with no entry in 30 days: #{number_with_delimiter(d.paid_inactive_30d)}.
      In 90 days: #{number_with_delimiter(d.paid_inactive_90d)}.

    %h5.s-stats-h5 Loyalty milestones (past year)
    %p.s-stats-sub
      These require writing in almost every month / week / day of the year. Useful as a super-user count, not as a retention rate.
    - loyalty = d.loyalty
    %table.table.table-striped.s-stats-table
      %thead
        %tr
          %th Milestone
          %th All
          %th PRO
          %th Free
      %tbody
        %tr
          %td ≥1 entry
          %td= number_with_delimiter(loyalty[:all][:yearly_count])
          %td
            = number_with_delimiter(loyalty[:pro][:yearly_count])
            %span.s-stats-meta= d.format_rate(d.share_rate(loyalty[:pro][:yearly_count], inv[:pro]))
          %td= number_with_delimiter(loyalty[:free][:yearly_count])
        %tr
          %td ≥11 months with an entry
          %td= number_with_delimiter(loyalty[:all][:monthly_count])
          %td= number_with_delimiter(loyalty[:pro][:monthly_count])
          %td= number_with_delimiter(loyalty[:free][:monthly_count])
        %tr
          %td ≥51 weeks with an entry
          %td= number_with_delimiter(loyalty[:all][:weekly_count])
          %td= number_with_delimiter(loyalty[:pro][:weekly_count])
          %td= number_with_delimiter(loyalty[:free][:weekly_count])
        %tr
          %td ≥364 days with an entry
          %td= number_with_delimiter(loyalty[:all][:daily_count])
          %td= number_with_delimiter(loyalty[:pro][:daily_count])
          %td= number_with_delimiter(loyalty[:free][:daily_count])

  %section.s-stats-section
    %h4 Acquisition sources
    %p.s-stats-sub First-touch referrer. MRR is current recurring revenue from that source, not 30-day only.
    %table.table.table-striped.s-stats-table
      %thead
        %tr
          %th Source
          %th Signups (30d)
          %th First entry (30d)
          %th PRO (30d)
          %th Activation
          %th Conversion
          %th Current MRR
      %tbody
        - d.sources.each do |row|
          %tr
            %td= row[:source]
            %td= number_with_delimiter(row[:signups_30d])
            %td= number_with_delimiter(row[:first_entries_30d])
            %td= number_with_delimiter(row[:upgrades_30d])
            %td= d.format_rate(row[:activation_rate])
            %td= d.format_rate(row[:conversion_rate])
            %td= d.format_cents(row[:mrr_cents])

  %section.s-stats-section
    %h4 Email health
    %p.s-stats-sub Daily send/fail/reply figures come from the snapshot (Mailgun + inbound entries). Lifetime totals are live.
    %table.table.table-striped.s-stats-table
      %tbody
        %tr
          %th Latest snapshot sent
          %td= d.email_health[:sent] ? number_with_delimiter(d.email_health[:sent]) : "—"
        %tr
          %th Failed
          %td= d.email_health[:failed] ? number_with_delimiter(d.email_health[:failed]) : "—"
        %tr
          %th Inbound replies that day
          %td= d.email_health[:replies] ? number_with_delimiter(d.email_health[:replies]) : "—"
        %tr
          %th Delivery rate
          %td= d.format_rate(d.email_health[:delivery_rate])
        %tr
          %th Reply rate that day
          %td= d.format_rate(d.email_health[:reply_rate])
        %tr
          %th Lifetime sent / received
          %td
            = number_with_delimiter(d.email_health[:lifetime_sent])
            \/
            = number_with_delimiter(d.email_health[:lifetime_received])
            %span.s-stats-meta= d.format_rate(d.lifetime_reply_rate)

  %section.s-stats-section
    %h4 MCP
    %p.s-stats-sub
      Connected is a live OAuth token with mcp:access that is not revoked or expired.
      Usage is tool calls (search, list, analyze, create, image upload) from the remote connector and in-browser WebMCP.
      Query text is not stored.
    - mcp = d.mcp
    %table.table.table-striped.s-stats-table
      %tbody
        %tr
          %th Connected now
          %td
            = number_with_delimiter(mcp[:connected_now])
            %span.s-stats-meta
              = number_with_delimiter(mcp[:connected_ever])
              ever authorized
        %tr
          %th Active users
          %td
            = number_with_delimiter(mcp[:active_users_7d])
            in 7 days /
            = number_with_delimiter(mcp[:active_users_30d])
            in 30 days
        %tr
          %th Tool calls
          %td
            = number_with_delimiter(mcp[:calls_today])
            today /
            = number_with_delimiter(mcp[:calls_7d])
            in 7 days /
            = number_with_delimiter(mcp[:calls_30d])
            in 30 days
        %tr
          %th OAuth / WebMCP (30d)
          %td
            = number_with_delimiter(mcp[:oauth_calls_30d])
            \/
            = number_with_delimiter(mcp[:webmcp_calls_30d])
        %tr
          %th Calls per active user (30d)
          %td= d.mcp_calls_per_active_30d || "—"
        %tr
          %th Success rate (30d)
          %td= d.format_rate(mcp[:success_rate_30d])
    - if mcp[:tools].any?
      %h5.s-stats-h5 Tools (30 days)
      %table.table.table-striped.s-stats-table
        %thead
          %tr
            %th Tool
            %th Calls
            %th Users
        %tbody
          - mcp[:tools].each do |row|
            %tr
              %td= row[:name]
              %td= number_with_delimiter(row[:calls])
              %td= number_with_delimiter(row[:users])
    - if mcp[:clients].any?
      %h5.s-stats-h5 Connected clients
      %table.table.table-striped.s-stats-table
        %thead
          %tr
            %th Client
            %th Users
        %tbody
          - mcp[:clients].each do |row|
            %tr
              %td= row[:name]
              %td= number_with_delimiter(row[:users])

  %section.s-stats-section
    %h4 Cash vs recurring
    %p.s-stats-sub Payments by month are cash collected, not MRR. Recurring run rate is the decision-bar ARR above.
    %table.table.table-striped.s-stats-table
      %tbody
        %tr
          %th Cash this month
          %td= d.format_cents(d.cash_collected_month_cents)
        %tr
          %th Cash this year
          %td= d.format_cents(d.cash_collected_year_cents)
        %tr
          %th Cash all time
          %td
            = d.format_cents(d.cash_collected_all_time_cents)
            %span.s-stats-meta
              = succeed "." do
                = link_to "#{number_with_delimiter(d.payment_count)} payments", payments_path
        %tr
          %th Annual renewals in next 30 days
          %td= number_with_delimiter(d.upcoming_renewals_count)
        %tr
          %th At-risk renewals
          %td
            = number_with_delimiter(d.at_risk[:monthly_count])
            monthly /
            = number_with_delimiter(d.at_risk[:yearly_count])
            yearly
            %span.s-stats-meta= d.format_cents(d.at_risk[:mrr_cents])

  %section.s-stats-section
    %h4 Inventory
    %p.s-stats-sub PRO % is of registered users, not of entries.
    %table.table.table-striped.s-stats-table
      %tbody
        %tr
          %th Entries
          %td= number_with_delimiter(inv[:entries])
        %tr
          %th Entries with photos
          %td
            = succeed "." do
              = link_to number_with_delimiter(inv[:photos]), admin_photos_path
            %span.s-stats-meta= d.format_rate(d.share_rate(inv[:photos], inv[:entries]))
        %tr
          %th Users
          %td= number_with_delimiter(inv[:users])
        %tr
          %th PRO / Free
          %td
            = number_with_delimiter(inv[:pro])
            \/
            = number_with_delimiter(inv[:free])
            %span.s-stats-meta= d.format_rate(d.pro_share_of_users)
        %tr
          %th Monthly / Yearly / Lifetime
          %td
            = number_with_delimiter(inv[:monthly])
            \/
            = number_with_delimiter(inv[:yearly])
            \/
            = number_with_delimiter(inv[:forever])
            %span.s-stats-meta= d.format_rate(d.yearly_share_of_pro)
        %tr
          %th Stripe / Gumroad / PayPal
          %td
            = number_with_delimiter(inv[:stripe])
            \/
            = number_with_delimiter(inv[:gumroad])
            \/
            = number_with_delimiter(inv[:paypal])

  %section.s-stats-section
    %h4 Trends
    - if d.snapshot_count.zero?
      %p.s-stats-sub
        MRR / activation history starts after the first snapshot. Signups, entries, upgrades, and cash still use live records.
    - else
      %h5.s-stats-h5 MRR
      = line_chart d.chart_mrr, discrete: true, prefix: "$"
      %h5.s-stats-h5 New vs churned MRR
      = line_chart d.chart_net_mrr, discrete: true, prefix: "$"
      %h5.s-stats-h5 72-hour first-entry activation
      = line_chart d.chart_activation, discrete: true, suffix: "%"
      %h5.s-stats-h5 Email reply rate
      = line_chart d.chart_reply_rate, discrete: true, suffix: "%"

    %h5.s-stats-h5 Signups over the last 90 days
    = line_chart d.chart_signups, discrete: true
    %h5.s-stats-h5 Entries over the last 90 days
    = line_chart d.chart_entries, discrete: true
    %h5.s-stats-h5 First upgrades over the last 90 days
    %p.s-stats-sub Includes people who later canceled. Renewals are not counted.
    = line_chart d.chart_upgrades, discrete: true
    %h5.s-stats-h5 MCP tool calls over the last 90 days
    = line_chart d.chart_mcp_calls, discrete: true
    %h5.s-stats-h5 Cash collected by month
    = column_chart d.chart_cash, discrete: true, prefix: "$"

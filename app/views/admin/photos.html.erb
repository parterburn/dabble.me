<% title "Admin Photos" %>
<% content_for :tailwind, true %>

<div class="tw mx-auto max-w-6xl pt-4 pb-16 sm:pt-8">
  <%= render "admin/header", title: "Photos", intro: "Every entry photo, newest first. Click one to open the original." %>

  <% if @entries.empty? %>
    <p class="card px-5 py-8 text-center text-sm text-muted">No photos yet.</p>
  <% else %>
    <div class="mb-6">
      <%= paginate @entries, theme: "tw" %>
    </div>

    <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 sm:gap-3 lg:grid-cols-6">
      <% @entries.each do |entry| %>
        <%= link_to entry.image_url_cdn(cloudflare: false), target: "_blank", rel: "noopener",
              class: "block aspect-square overflow-hidden rounded-lg border border-subtle bg-surface-elevated transition-opacity hover:opacity-90 *:size-full *:object-cover" do %>
          <%= image_code(entry, cloudflare: false) %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-6">
      <%= paginate @entries, theme: "tw" %>
    </div>
  <% end %>
</div>

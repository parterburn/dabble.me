<%# Asks someone with no passkey to add one, on the journal's own pages (PasskeyNudge has the
    rules). Hidden where the browser can't make a passkey. The iOS app asks the same way
    (PasskeyPrompt.swift). %>
<% if PasskeyNudge.show?(current_user, cookies, controller_name, action_name) %>
  <div class="col-md-8 col-md-offset-2 alert alert-info" role="status" id="passkey-nudge" hidden>
    <strong>Add a passkey.</strong>
    Sign in with Face ID, Touch ID or your device's PIN instead of a password, and nobody can phish it.
    <%= link_to "Add a passkey", "#{security_path}#passkeys" %> ·
    <a href="#" id="passkey-nudge-dismiss">Not now</a>
  </div>
  <div class="clearfix"></div>
  <script>
    (function () {
      var nudge = document.getElementById("passkey-nudge");
      if (!nudge || !window.PublicKeyCredential) return;
      nudge.hidden = false;
      document.getElementById("passkey-nudge-dismiss").addEventListener("click", function (e) {
        e.preventDefault();
        var asks = <%= PasskeyNudge.dismissals(cookies) %> + 1;
        var until = Math.floor(Date.now() / 1000) + <%= PasskeyNudge::SNOOZE_DAYS %> * 86400;
        document.cookie = "<%= PasskeyNudge::COOKIE %>=" + asks + ":" + until +
          "; max-age=" + 5 * 365 * 86400 + "; path=/; SameSite=Lax<%= '; Secure' if request.ssl? %>";
        nudge.hidden = true;
      });
    })();
  </script>
<% end %>

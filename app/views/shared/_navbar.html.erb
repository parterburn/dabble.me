<nav class="navbar navbar-default navbar-fixed-top" role="navigation" style="font-family: 'Instrument Sans', sans-serif;">
  <div class="container">
    <div class="navbar-header">
      <button class="navbar-toggle" type="button" data-toggle="collapse" data-target=".navbar-collapse">
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <% if user_signed_in? && current_user.is_pro? %>
        <%= link_to "Write", new_entry_path, class: "s-write-icon visible-xs #{'active' if params[:controller] == 'entries' && params[:action].in?(['new', 'create'])}" %>
      <% end %>
      <%= link_to root_path, class: 'navbar-brand', title: "Dabble me." do %>
        <span>
          Dabble me.
        </span>
      <% end %>
    </div>

    <div class="collapse navbar-collapse">
      <ul class="nav navbar-nav">
        <li class="<%= 'hidden-xs' if user_signed_in? && current_user.is_pro? %> <%= 'active' if params[:controller] == 'entries' && params[:action].in?(['new', 'create']) %>">
          <%= link_to new_entry_path do %>
            <span>Write</span>
          <% end %>
        </li>

        <li class="<%= 'active' if params[:controller] == 'entries' && params[:action] == 'index' %>">
          <%= link_to entries_path do %>
            <span>Entries</span>
          <% end %>
        </li>

        <li class="<%= 'active' if params[:action] == "review" %>">
          <%= link_to rewind_path(Date.today.year), title: "Analytics" do %>
            <span>Stats</span>
          <% end %>
        </li>

        <li class="<%= 'active' if current_page?(entries_calendar_path) %>">
          <%= link_to entries_calendar_path, title: "Calendar View" do %>
            <span class="slab-icon slab-icon--calendar hidden-xs" aria-hidden="true"></span>
            <span class="visible-xs-inline-block">Calendar</span>
          <% end %>
        </li>

        <li class="<%= 'active' if current_page?(search_path) %>">
          <%= link_to search_path, title: "Search" do %>
            <span class="slab-icon slab-icon--search hidden-xs" aria-hidden="true"></span>
            <span class="visible-xs-inline-block">Search</span>
          <% end %>
        </li>

        <% if user_signed_in? && current_user.admin? %>
          <li class="dropdown <%= 'active' if params[:controller].in?(['admin', 'inspirations', 'payments']) %>">
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
              <span class="slab-icon slab-icon--lock hidden-xs" aria-hidden="true"></span>
              <span class="visible-xs-inline-block">Admin</span>
            </a>
            <ul class="dropdown-menu" role="menu">
              <li class="<%= 'active' if current_page?(inspirations_path) %>">
                <%= link_to "Inspirations", inspirations_path, title: "Inspirations" %>
              </li>
              <li class="<%= 'active' if current_page?(admin_oauth_apps_path) %>">
                <%= link_to "OAuth apps", admin_oauth_apps_path, title: "Admin OAuth apps" %>
              </li>
              <li class="<%= 'active' if current_page?(payments_path) %>">
                <%= link_to "Payments", payments_path, title: "Payments" %>
              </li>
              <li class="<%= 'active' if current_page?(admin_photos_path) %>">
                <%= link_to "Photos", admin_photos_path, title: "Admin Photos" %>
              </li>
              <li class="<%= 'active' if current_page?(admin_stats_path) %>">
                <%= link_to "Stats", admin_stats_path, title: "Admin Stats" %>
              </li>
              <li class="<%= 'active' if current_page?(admin_users_path) %>">
                <%= link_to "Users", admin_users_path, title: "Admin Users" %>
              </li>
            </ul>
          </li>
        <% end %>
      </ul>

      <ul class="nav navbar-nav navbar-right">
        <% if user_signed_in? && current_user.sign_in_count < 10 && !cookies[:viewed_settings] && (current_page?(entries_path) || current_page?(root_path)) %>
          <% add_popover = "popover_settings" %>
          <% if current_user.frequency.count > 0 %>
            <% current_settings = "You will be emailed at <strong>#{current_user.send_time.strftime("%-I %P")} #{current_user.send_timezone}</strong> on <strong>#{current_user.frequencies}</strong>." %>
          <% else %>
            <% current_settings = "Email reminders are currently <strong>disabled</strong>." %>
          <% end %>
        <% end %>
        <% on_settings = current_page?(edit_user_registration_path) %>
        <% on_security = current_page?(security_path) %>

        <%# Phones: plain links in the collapsed menu. %>
        <li class="visible-xs <%= 'active' if on_settings %>"><%= link_to "Settings", edit_user_registration_path %></li>
        <li class="visible-xs <%= 'active' if on_security %>"><%= link_to "Account Security", security_path %></li>
        <li class="visible-xs"><%= link_to "Logout", destroy_user_session_path, method: :delete %></li>

        <%# Desktop: the same links behind the "me" avatar. %>
        <li class="dropdown hidden-xs <%= 'active' if on_settings || on_security %>" rel="<%= add_popover %>" title="" data-content="<%= current_settings %>" data-placement="bottom">
          <a class="dropdown-toggle s-avatar-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false" title="Account">
            <%= image_tag "logos/me-avatar.png", alt: "Account", class: "s-avatar", width: 32, height: 32 %>
          </a>
          <ul class="dropdown-menu" role="menu">
            <li class="<%= 'active' if on_settings %>">
              <%= link_to edit_user_registration_path do %><span class="slab-icon slab-icon--gear" aria-hidden="true"></span>Settings<% end %>
            </li>
            <li class="<%= 'active' if on_security %>">
              <%= link_to security_path do %><span class="slab-icon slab-icon--shield" aria-hidden="true"></span>Account Security<% end %>
            </li>
            <li role="separator" class="divider"></li>
            <li>
              <%= link_to destroy_user_session_path, method: :delete do %><span class="slab-icon slab-icon--sign-out" aria-hidden="true"></span>Logout<% end %>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
